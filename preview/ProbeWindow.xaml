<!--
    交互状态校验窗口（配合 preview 的 -probe 模式离屏渲染）。
    专门覆盖那些"静态看不出问题、只有进入交互态才暴露"的缺陷：
      1. DataGrid 单元格进入编辑态：编辑器高度是否自适应、文字是否上下居中；
      2. Expander 展开长内容：内容区是否出现滚动条，而不是把窗口撑高；
      3. DatePicker：日历按钮是否压住日期文字、是否仍是系统外观；
      4. ComboBox 展开：弹层是否主题化、是否压住输入框。
-->
<Window x:Class="WpfStylePreview.ProbeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="交互状态校验"
        Width="860" Height="720"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="{StaticResource Layout.WindowPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. DatePicker -->
        <GroupBox Grid.Row="0" Header="1. DatePicker（自绘模板：文字不被日历按钮压住）">
            <StackPanel Orientation="Horizontal">
                <DatePicker x:Name="PickerNormal" Width="220" Margin="0,0,16,0"
                            SelectedDate="2026-11-05" />
                <DatePicker x:Name="PickerDisabled" Width="220" IsEnabled="False"
                            SelectedDate="2026-11-05" />
            </StackPanel>
        </GroupBox>

        <!-- 2. ComboBox 展开 -->
        <GroupBox Grid.Row="1" Header="2. ComboBox 展开态">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="Combo" Width="220" Margin="0,0,16,0" SelectedIndex="0"
                          IsDropDownOpen="True">
                    <ComboBoxItem Content="英语（en）" />
                    <ComboBoxItem Content="中文（zh）" />
                    <ComboBoxItem Content="俄语（ru）" />
                </ComboBox>
            </StackPanel>
        </GroupBox>

        <!-- 3. Expander 展开长内容 -->
        <GroupBox Grid.Row="2" Header="3. Expander 展开长内容（内容区自带滚动条）">
            <Expander x:Name="Expander" IsExpanded="True">
                <Expander.Header>高级参数</Expander.Header>
                <StackPanel x:Name="ExpanderContent">
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="以下参数一般保持默认即可。" Margin="0,0,0,8" />
                    <CheckBox Content="跳过已是目标语言的文本" IsChecked="True" Margin="0,0,0,6" />
                    <CheckBox Content="保留尺寸公差符号" IsChecked="True" Margin="0,0,0,6" />
                    <CheckBox Content="失败自动重试" Margin="0,0,0,6" />
                    <CheckBox Content="术语库优先" Margin="0,0,0,6" />
                    <CheckBox Content="保留属性块编号" Margin="0,0,0,6" />
                    <CheckBox Content="跳过隐藏图层" Margin="0,0,0,6" />
                    <CheckBox Content="同步更新块属性" Margin="0,0,0,6" />
                    <CheckBox Content="保留原图框" Margin="0,0,0,6" />
                    <CheckBox Content="导出前预览差异" Margin="0,0,0,6" />
                    <CheckBox Content="记录撤销日志" Margin="0,0,0,6" />
                    <CheckBox Content="清理临时文件" Margin="0,0,0,6" />
                    <CheckBox Content="自动保存工程副本" Margin="0,0,0,12" />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="再补几行，确认内容超出时出现滚动条而不是把窗口撑高。" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="第 1 行占位内容" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="第 2 行占位内容" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="第 3 行占位内容" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="第 4 行占位内容" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="第 5 行占位内容" Margin="0,6,0,0" />
                </StackPanel>
            </Expander>
        </GroupBox>

        <!-- 3.5 日历面板本体（直接渲染，检查是否塌成竖条） -->
        <GroupBox Grid.Row="3" Header="3.5 日历面板" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Calendar x:Name="Calendar" Width="240" Margin="0,0,16,0" />
                <TextBlock Text="右：DataGrid 编辑态" VerticalAlignment="Center" />
            </StackPanel>
        </GroupBox>

        <!-- 4. DataGrid 编辑态 -->
        <GroupBox Grid.Row="4" Header="4. DataGrid 编辑态（编辑器自适应高度、文字上下居中）">
            <DataGrid x:Name="Grid" Height="180" AutoGenerateColumns="False"
                      IsReadOnly="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" CanUserResizeRows="False"
                      SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="图号" Binding="{Binding Code}" Width="110" />
                    <DataGridTextColumn Header="图名" Binding="{Binding Name}" Width="*" MinWidth="160" />
                    <DataGridTextColumn Header="文本数" Binding="{Binding TextCount}" Width="90" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>
