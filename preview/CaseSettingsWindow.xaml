<!--
    案例 1：密集设置表单（紧凑布局）

    演示点：
    1. 窗口用 SizeToContent="Height" + MinHeight，内容区一层 ScrollViewer；
    2. 表单用三列骨架（标签 Auto+MinWidth / 输入 *+MinWidth），行距靠 Layout.FormRowMargin；
    3. 一屏能看到更多字段，而不是每个字段占一行 + 大间距；
    4. 底部操作栏独占一行，状态文案在它上面，不与按钮同行。
-->
<Window x:Class="WpfStylePreview.CaseSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="案例 · 密集设置表单"
        Width="1000"
        SizeToContent="Height"
        MinWidth="760" MinHeight="380"
        WindowStartupLocation="CenterScreen">

    <Border Background="{StaticResource Brush.WindowBackground}">
        <Grid Margin="{StaticResource Layout.WindowPadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 页头：标题 + 一句话说明 -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,10"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="转换设置" Style="{StaticResource Text.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="紧凑骨架：三列并排，行距 3px，控件高 32px"
                               Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 内容区：唯一的垂直滚动层 -->
            <ScrollViewer Grid.Row="1"
                          Style="{StaticResource ScrollViewer.Base}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- 服务 -->
                    <GroupBox Header="服务连接">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="{StaticResource Layout.FormLabelMinWidth}" />
                                <ColumnDefinition Width="*" MinWidth="{StaticResource Layout.InputMinWidth}" />
                                <ColumnDefinition Width="{StaticResource Layout.ColumnGap}" />
                                <ColumnDefinition Width="Auto" MinWidth="{StaticResource Layout.FormLabelMinWidth}" />
                                <ColumnDefinition Width="*" MinWidth="{StaticResource Layout.InputMinWidth}" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="服务地址" Style="{StaticResource Text.Label}" />
                            <TextBox Grid.Column="1" Margin="0,3" Text="http://127.0.0.1:8080/v1" />

                            <TextBlock Grid.Column="3" Text="模型名称" Style="{StaticResource Text.Label}" />
                            <TextBox Grid.Column="4" Margin="0,3" Text="demo-translation-model" />

                            <TextBlock Grid.Row="1" Text="访问令牌" Style="{StaticResource Text.Label}" />
                            <PasswordBox Grid.Row="1" Grid.Column="1" Margin="0,3" />

                            <TextBlock Grid.Row="1" Grid.Column="3" Text="超时（秒）" Style="{StaticResource Text.Label}" />
                            <TextBox Grid.Row="1" Grid.Column="4" Margin="0,3" Text="300" />

                            <TextBlock Grid.Row="2" Text="目标语言" Style="{StaticResource Text.Label}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,3" SelectedIndex="0">
                                <ComboBoxItem Content="英语 (en)" />
                                <ComboBoxItem Content="德语 (de)" />
                                <ComboBoxItem Content="日语 (ja)" />
                            </ComboBox>

                            <StackPanel Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Margin="0,3">
                                <CheckBox Content="启用术语库" IsChecked="True" Margin="0,0,16,0" />
                                <CheckBox Content="保留图层结构" IsChecked="True" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- 转换参数 -->
                    <GroupBox Header="转换参数">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="{StaticResource Layout.FormLabelMinWidth}" />
                                <ColumnDefinition Width="*" MinWidth="{StaticResource Layout.InputMinWidth}" />
                                <ColumnDefinition Width="{StaticResource Layout.ColumnGap}" />
                                <ColumnDefinition Width="Auto" MinWidth="{StaticResource Layout.FormLabelMinWidth}" />
                                <ColumnDefinition Width="*" MinWidth="{StaticResource Layout.InputMinWidth}" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="并发请求数" Style="{StaticResource Text.Label}" />
                            <TextBox Grid.Column="1" Margin="0,3" Text="4" />

                            <TextBlock Grid.Column="3" Text="重试次数" Style="{StaticResource Text.Label}" />
                            <TextBox Grid.Column="4" Margin="0,3" Text="1" />

                            <TextBlock Grid.Row="1" Text="单位（合法值）" Style="{StaticResource Text.Label}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Text="millimeter" />

                            <TextBlock Grid.Row="1" Grid.Column="3" Text="保留公差" Style="{StaticResource Text.Label}" />
                            <ComboBox Grid.Row="1" Grid.Column="4" Margin="0,3" SelectedIndex="0">
                                <ComboBoxItem Content="是" />
                                <ComboBoxItem Content="否" />
                            </ComboBox>

                            <TextBlock Grid.Row="2" Text="缩放因子" Style="{StaticResource Text.Label}" />
                            <Slider Grid.Row="2" Grid.Column="1" Margin="0,3" Minimum="0.5" Maximum="2" Value="1"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="4" Text="1.00×" Style="{StaticResource Text.Label}" />
                        </Grid>
                    </GroupBox>

                    <!-- 输出 -->
                    <GroupBox Header="输出">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="{StaticResource Layout.FormLabelMinWidth}" />
                                <ColumnDefinition Width="*" MinWidth="{StaticResource Layout.InputMinWidth}" />
                                <ColumnDefinition Width="{StaticResource Layout.ColumnGap}" />
                                <ColumnDefinition Width="Auto" MinWidth="{StaticResource Layout.FormLabelMinWidth}" />
                                <ColumnDefinition Width="*" MinWidth="{StaticResource Layout.InputMinWidth}" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="输出目录" Style="{StaticResource Text.Label}" />
                            <TextBox Grid.Column="1" Margin="0,3" Text="D:\out\translated" />

                            <TextBlock Grid.Column="3" Text="格式" Style="{StaticResource Text.Label}" />
                            <ComboBox Grid.Column="4" Margin="0,3" SelectedIndex="0">
                                <ComboBoxItem Content="DWG（原地写回）" />
                                <ComboBoxItem Content="DXF 副本" />
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="日期范围" Style="{StaticResource Text.Label}" />
                            <DatePicker Grid.Row="1" Grid.Column="1" Margin="0,3" SelectedDate="2026-11-06" />

                            <TextBlock Grid.Row="1" Grid.Column="3" Text="处理批次" Style="{StaticResource Text.Label}" />
                            <TextBox Grid.Row="1" Grid.Column="4" Margin="0,3" Text="B-2026-1106" />
                        </Grid>
                    </GroupBox>

                    <!-- 多行：Auto 行 + 顶部对齐，内容自然增高 -->
                    <GroupBox Header="系统提示词">
                        <TextBox Style="{StaticResource TextBox.Multiline}"
                                 VerticalAlignment="Top"
                                 Height="Auto"
                                 Text="你是机械制图翻译引擎。保留尺寸公差与形位公差符号，只翻译说明性文字。" />
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <!-- 状态文案：独占一行，在按钮栏上面 -->
            <TextBlock Grid.Row="2"
                       Text="就绪 · 配置已保存 · 4 个文件待处理"
                       Style="{StaticResource Text.Caption}"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap" />

            <!-- 底部操作栏 -->
            <Border Grid.Row="3"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" IsCancel="True" Margin="0,0,8,0" />
                    <Button Content="保存配置" Margin="0,0,8,0" />
                    <Button Content="开始翻译" Style="{StaticResource Button.Primary}" IsDefault="True" MinWidth="88" />
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
