<Window x:Class="WpfStylePreview.LayoutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF UI Skills · 布局模板"
        Width="1240" Height="940"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen">

    <Border Background="{StaticResource Brush.WindowBackground}">
        <Grid Margin="{StaticResource Layout.WindowPadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                    Padding="0,0,0,12" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Geo.File}" Style="{StaticResource Icon.Medium}" Margin="0,0,8,0" />
                        <TextBlock Text="布局模板" Style="{StaticResource Text.Title}" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="六种常见窗口骨架：多列表单、双栏对照、主-细节、仪表盘网格、设置页、拆分视图。"
                               Style="{StaticResource Text.Caption}" Margin="28,4,0,0" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewer.Base}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- A. 多列表单 -->
                    <GroupBox Header="A. 两列表单（标签列 96，输入列 *，列间距 16）">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="图号" Style="{StaticResource Text.Label}" />
                            <TextBox Grid.Column="1" Margin="0,4" Text="A-001" />

                            <TextBlock Grid.Column="3" Text="图名" Style="{StaticResource Text.Label}" />
                            <TextBox Grid.Row="0" Grid.Column="4" Margin="0,4" Text="总装图" />

                            <TextBlock Grid.Row="1" Text="材料" Style="{StaticResource Text.Label}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="Q235" />

                            <TextBlock Grid.Row="1" Grid.Column="3" Text="比例" Style="{StaticResource Text.Label}" />
                            <ComboBox Grid.Row="1" Grid.Column="4" Margin="0,4" SelectedIndex="0">
                                <ComboBoxItem Content="1:1" />
                                <ComboBoxItem Content="1:2" />
                                <ComboBoxItem Content="2:1" />
                            </ComboBox>

                            <TextBlock Grid.Row="2" Text="设计者" Style="{StaticResource Text.Label}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="张工" />

                            <TextBlock Grid.Row="2" Grid.Column="3" Text="日期" Style="{StaticResource Text.Label}" />
                            <DatePicker Grid.Row="2" Grid.Column="4" Margin="0,4" />

                            <TextBlock Grid.Row="3" Text="备注" Style="{StaticResource Text.Label}"
                                       VerticalAlignment="Top" />
                            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,4"
                                     Style="{StaticResource TextBox.Multiline}"
                                     VerticalAlignment="Top" MaxHeight="140"
                                     Text="跨列的输入用 Grid.ColumnSpan，高度靠内容自然增长。" />
                        </Grid>
                    </GroupBox>

                    <!-- B. 双栏对照 -->
                    <GroupBox Header="B. 双栏对照（原文 / 译文，操作锚定在内容之间）">
                        <Grid Height="300">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <GroupBox Grid.Row="0" Header="原文">
                                <TextBox Style="{StaticResource TextBox.Multiline}"
                                         VerticalAlignment="Stretch"
                                         Text="TECHNICAL REQUIREMENTS:&#x0a;1. REMOVE ALL BURRS AND SHARP EDGES BEFORE ASSEMBLY.&#x0a;2. UNLESS OTHERWISE SPECIFIED, CHAMFER C0.5 AND FILLET R2.&#x0a;3. SURFACE TREATMENT: BLACK OXIDE." />
                            </GroupBox>

                            <StackPanel Grid.Row="1" Orientation="Horizontal"
                                        HorizontalAlignment="Center" Margin="0,8">
                                <TextBlock Text="翻译为" Style="{StaticResource Text.Label}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Width="130" SelectedIndex="0" Margin="0,0,12,0">
                                    <ComboBoxItem Content="中文（zh）" />
                                    <ComboBoxItem Content="英语（en）" />
                                </ComboBox>
                                <Button Style="{StaticResource Button.Primary}" Width="110">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Geo.Translate}" Style="{StaticResource Icon.Regular}" Margin="0,0,6,0" />
                                        <TextBlock Text="开始翻译" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <GroupBox Grid.Row="2" Header="译文">
                                <Grid>
                                    <TextBox Style="{StaticResource TextBox.Multiline}"
                                             IsReadOnly="True"
                                             VerticalAlignment="Stretch"
                                             Text="技术要求：&#x0a;1. 装配前去除所有毛刺与锐边。&#x0a;2. 未注倒角 C0.5，未注圆角 R2。&#x0a;3. 表面处理：发黑。" />
                                    <Button Style="{StaticResource Button.Icon}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,6,6,0" ToolTip="复制译文到剪贴板">
                                        <Path Data="{StaticResource Icon.Geo.Copy}" Style="{StaticResource Icon.Regular}" />
                                    </Button>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </GroupBox>

                    <!-- C. 主 - 细节 -->
                    <GroupBox Header="C. 主 - 细节（左侧列表固定宽，右侧详情填充，GridSplitter 可拖动）">
                        <Grid Height="260">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ListBox SelectedIndex="0">
                                <ListBoxItem Content="A-001 总装图" />
                                <ListBoxItem Content="A-002 零件图" />
                                <ListBoxItem Content="A-003 明细表" />
                                <ListBoxItem Content="A-004 焊接图" />
                                <ListBoxItem Content="A-005 液压原理图" />
                            </ListBox>

                            <GridSplitter Grid.Column="1" Width="6"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          ResizeBehavior="PreviousAndNext" />

                            <ScrollViewer Grid.Column="2" Style="{StaticResource ScrollViewer.Base}">
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="A-001 总装图" Style="{StaticResource Text.Section}" Margin="0,0,0,4" />
                                    <TextBlock Text="路径：D:\Projects\A-001.dwg" Style="{StaticResource Text.Hint}" Margin="0,0,0,10" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="文本数" Style="{StaticResource Text.Label}" />
                                        <TextBlock Grid.Column="1" Text="42" Style="{StaticResource Text.Body}" />

                                        <TextBlock Grid.Row="1" Text="状态" Style="{StaticResource Text.Label}" />
                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Badge.Done}">
                                            <TextBlock Text="已完成" Style="{StaticResource BadgeText.Done}" />
                                        </Border>

                                        <TextBlock Grid.Row="2" Text="说明" Style="{StaticResource Text.Label}"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Text.Body}"
                                                   Margin="0,6,0,0"
                                                   Text="该图纸已完成翻译，术语库命中 12 条，全部写回原图。" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </GroupBox>

                    <!-- D. 仪表盘网格 -->
                    <GroupBox Header="D. 仪表盘网格（等宽卡片，UniformGrid 自适应换行）">
                        <UniformGrid Columns="4" Margin="0">
                            <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="待处理图纸" Style="{StaticResource Text.Hint}" />
                                    <TextBlock Text="128" Style="{StaticResource Text.Title}" Margin="0,4,0,0" />
                                    <Border Style="{StaticResource Badge.Active}" Margin="0,8,0,0">
                                        <TextBlock Text="进行中" Style="{StaticResource BadgeText.Active}" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="已翻译文本" Style="{StaticResource Text.Hint}" />
                                    <TextBlock Text="3,482" Style="{StaticResource Text.Title}" Margin="0,4,0,0" />
                                    <Border Style="{StaticResource Badge.Done}" Margin="0,8,0,0">
                                        <TextBlock Text="已完成" Style="{StaticResource BadgeText.Done}" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="术语命中" Style="{StaticResource Text.Hint}" />
                                    <TextBlock Text="642" Style="{StaticResource Text.Title}" Margin="0,4,0,0" />
                                    <Border Style="{StaticResource Badge.Idle}" Margin="0,8,0,0">
                                        <TextBlock Text="待处理" Style="{StaticResource BadgeText.Idle}" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="失败项" Style="{StaticResource Text.Hint}" />
                                    <TextBlock Text="7" Style="{StaticResource Text.Title}" Margin="0,4,0,0" />
                                    <Border Style="{StaticResource Badge.Failed}" Margin="0,8,0,0">
                                        <TextBlock Text="需复查" Style="{StaticResource BadgeText.Failed}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </GroupBox>

                    <!-- E. 设置页 -->
                    <GroupBox Header="E. 设置页（左侧导航 + 右侧内容，低频参数用 Expander 折叠）">
                        <Grid Height="300">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ListBox SelectedIndex="0">
                                <ListBoxItem Content="常规" />
                                <ListBoxItem Content="翻译服务" />
                                <ListBoxItem Content="术语库" />
                                <ListBoxItem Content="高级" />
                            </ListBox>

                            <ScrollViewer Grid.Column="2" Style="{StaticResource ScrollViewer.Base}">
                                <StackPanel>
                                    <TextBlock Text="翻译服务" Style="{StaticResource Text.Section}" Margin="0,0,0,10" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="服务地址" Style="{StaticResource Text.Label}" />
                                        <TextBox Grid.Column="1" Margin="0,4" Text="http://127.0.0.1:21894/v1" />

                                        <TextBlock Grid.Row="1" Text="模型名称" Style="{StaticResource Text.Label}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="hy-mt2:1.8b-8k" />

                                        <TextBlock Grid.Row="2" Text="并发数" Style="{StaticResource Text.Label}" />
                                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Value="4" Maximum="16" />
                                            <TextBlock Grid.Column="1" Text="4" Style="{StaticResource Text.Caption}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </Grid>
                                    </Grid>

                                    <Expander Header="高级参数" IsExpanded="False" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="以下参数一般保持默认即可。" Style="{StaticResource Text.Hint}" Margin="0,0,0,8" />
                                            <CheckBox Content="跳过已是目标语言的文本" IsChecked="True" Margin="0,0,0,6" />
                                            <CheckBox Content="保留尺寸公差符号" IsChecked="True" Margin="0,0,0,6" />
                                            <CheckBox Content="失败自动重试" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </GroupBox>

                    <!-- F. 拆分视图 -->
                    <GroupBox Header="F. 拆分视图（上表下日志，中间 GridSplitter 可调比例）">
                        <Grid Height="300">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="140" />
                            </Grid.RowDefinitions>

                            <DataGrid x:Name="GridLayouts"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      CanUserResizeRows="False"
                                      SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="图号" Binding="{Binding Code}" Width="110" />
                                    <DataGridTextColumn Header="图名" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="文本数" Binding="{Binding TextCount}" Width="90" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <GridSplitter Grid.Row="1" Height="6"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          ResizeBehavior="PreviousAndNext" />

                            <GroupBox Grid.Row="2" Header="处理日志">
                                <TextBox Style="{StaticResource TextBox.Code}"
                                         VerticalAlignment="Stretch"
                                         Text="[10:00:01] 开始处理 A-001.dwg&#x0a;[10:00:02] 提取文本 42 条，跳过 3 条&#x0a;[10:00:03] 调用翻译服务&#x0a;[10:00:05] 已翻译 39 条，术语库命中 12 条&#x0a;[10:00:06] 写回图纸完成" />
                            </GroupBox>
                        </Grid>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"
                    Padding="0,12,0,0" Margin="0,12,0,0">
                <Grid>
                    <TextBlock Text="表单行用 Auto，只有一个区域用 * 填充；GridSplitter 用于可调比例的分栏。"
                               Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" IsCancel="True" Margin="0,0,8,0" />
                        <Button Content="应用" Style="{StaticResource Button.Primary}" IsDefault="True" MinWidth="88" />
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
