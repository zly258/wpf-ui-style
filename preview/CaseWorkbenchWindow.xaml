<Window x:Class="WpfStylePreview.CaseWorkbenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="案例 · 工程工作台布局（Workbench）"
        Width="1260" Height="820"
        MinWidth="1020" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Border Background="{StaticResource Brush.WindowBackground}">
        <Grid Margin="{StaticResource Layout.WindowPadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. 顶部工作台标题与状态 -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,10"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="工程工作台 · 零件与特征检查器" Style="{StaticResource Text.Title}" FontWeight="SemiBold" />
                        <Border Margin="12,0,0,0"
                                Background="{StaticResource Brush.Success.Subtle}"
                                CornerRadius="{StaticResource Radius.Small}"
                                Padding="8,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="已连接 3D 宿主引擎"
                                       Style="{StaticResource Text.Caption}"
                                       Foreground="{StaticResource Brush.Success}"
                                       FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <!-- 右侧工具命令 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="刷新特征树" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" Click="BtnRefreshTree_Click" />
                        <Button Content="重新计算质量" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" Click="BtnRecalculate_Click" />
                        <Button Content="应用所有修改" Style="{StaticResource Button.Primary}" Click="BtnApply_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. 快捷工具条 -->
            <Border Grid.Row="1"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Small}"
                    Padding="8,6"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="当前活动图纸：" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="ASM-0482_减速箱总成.iam" Style="{StaticResource Text.Body}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <TextBlock Text="工作坐标系：" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="110" Height="28" SelectedIndex="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <ComboBoxItem Content="世界原点" />
                            <ComboBoxItem Content="主轴法兰面" />
                            <ComboBoxItem Content="底座基准面" />
                        </ComboBox>

                        <CheckBox Content="开启实时干涉检测" VerticalAlignment="Center" IsChecked="True" Margin="0,0,12,0" />
                        <CheckBox Content="显示公差基准符号" VerticalAlignment="Center" IsChecked="False" />
                    </StackPanel>

                    <!-- 右侧视口模式切换 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="视口模式：" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="90" Height="28" SelectedIndex="0" VerticalAlignment="Center">
                            <ComboBoxItem Content="带边着色" />
                            <ComboBoxItem Content="线框模型" />
                            <ComboBoxItem Content="真实渲染" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. 三栏核心工作区（左：特征树 | 中：视口与特征表 | 右：属性检查器） -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <!-- 左侧特征树 -->
                    <ColumnDefinition Width="Auto" MinWidth="220" MaxWidth="380" />
                    <ColumnDefinition Width="8" />
                    <!-- 中间主工作区 -->
                    <ColumnDefinition Width="*" MinWidth="360" />
                    <ColumnDefinition Width="8" />
                    <!-- 右侧属性检查器 -->
                    <ColumnDefinition Width="300" MinWidth="240" MaxWidth="440" />
                </Grid.ColumnDefinitions>

                <!-- ================= 左侧：构件与装配特征树 ================= -->
                <GroupBox Grid.Column="0" Header="装配构件与特征导航">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 搜索框 -->
                        <TextBox x:Name="TxtTreeFilter"
                                 Grid.Row="0"
                                 Margin="0,0,0,6"
                                 Height="28"
                                 ToolTip="输入构件或特征名称快速过滤" />

                        <!-- 树控件 -->
                        <TreeView x:Name="TreeAssembly"
                                  Grid.Row="1"
                                  SelectedItemChanged="TreeAssembly_SelectedItemChanged">
                            <TreeViewItem Header="ASM-0482 减速机装配体" IsExpanded="True">
                                <TreeViewItem Header="箱体底座 (Cast-Base)" IsExpanded="True">
                                    <TreeViewItem Header="主腔拉伸特征 Extrude1" />
                                    <TreeViewItem Header="底面安装孔阵列 HolePattern4" />
                                    <TreeViewItem Header="减速机放油口螺纹 Thread_M16" />
                                </TreeViewItem>
                                <TreeViewItem Header="输入高速轴系 (Shaft-Input)" IsExpanded="True">
                                    <TreeViewItem Header="斜齿小齿轮 Gear-Pinion-Z19" IsSelected="True" />
                                    <TreeViewItem Header="深沟球轴承 6205-2RS" />
                                    <TreeViewItem Header="端盖密封圈 OilSeal_TC25" />
                                </TreeViewItem>
                                <TreeViewItem Header="输出低速轴系 (Shaft-Output)" IsExpanded="False">
                                    <TreeViewItem Header="大齿轮 Gear-Wheel-Z76" />
                                    <TreeViewItem Header="圆锥滚子轴承 30208" />
                                    <TreeViewItem Header="平键联接 Key_12x8x45" />
                                </TreeViewItem>
                                <TreeViewItem Header="标准件明细 (Hardware)" IsExpanded="False">
                                    <TreeViewItem Header="内六角螺栓 M8x35 (x8)" />
                                    <TreeViewItem Header="弹簧垫圈 8 (x8)" />
                                </TreeViewItem>
                            </TreeViewItem>
                        </TreeView>
                    </Grid>
                </GroupBox>

                <!-- 分割线 -->
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- ================= 中间：主视口工作区与特征参数表 ================= -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <!-- 视口模拟区 -->
                        <RowDefinition Height="2*" MinHeight="180" />
                        <RowDefinition Height="8" />
                        <!-- 下半部分：当前选定构件的子参数表 -->
                        <RowDefinition Height="1*" MinHeight="140" />
                    </Grid.RowDefinitions>

                    <!-- 视口画板模拟 -->
                    <GroupBox Grid.Row="0" Header="3D 模型交互视口">
                        <Grid Background="{StaticResource Brush.SurfaceSunken}">
                            <!-- 视口中心示意图纸/模型信息卡片 -->
                            <Border Background="{StaticResource Brush.Surface}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Card}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="24,18">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtSelectedNodeTitle"
                                               Text="当前选中项：斜齿小齿轮 Gear-Pinion-Z19"
                                               Style="{StaticResource Text.Section}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="齿数: 19 | 模数: 2.5 mm | 压力角: 20° | 螺旋角: 14°02'10''"
                                               Style="{StaticResource Text.Caption}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,12" />

                                    <!-- 操作与状态示意 -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Background="{StaticResource Brush.Success.Subtle}"
                                                CornerRadius="{StaticResource Radius.Small}"
                                                Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Text="几何约束完全匹配"
                                                       FontSize="{StaticResource FontSize.Caption}"
                                                       Foreground="{StaticResource Brush.Success}"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <Border Background="{StaticResource Brush.SurfaceAlt}"
                                                CornerRadius="{StaticResource Radius.Small}"
                                                Padding="8,3">
                                            <TextBlock Text="啮合间隙 0.12 mm (符合 ISO 1328)"
                                                       FontSize="{StaticResource FontSize.Caption}"
                                                       Foreground="{StaticResource Brush.Text.Secondary}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 视口左上角悬浮信息 -->
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                <TextBlock Text="视口视角：等轴测 (Isometric)" Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="渲染帧率：60.0 FPS · 实体数：42" Style="{StaticResource Text.Caption}" />
                            </StackPanel>

                            <!-- 视口右下角缩放工具 -->
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="10">
                                <Button Content="重置视角" Style="{StaticResource Button.Secondary}" Height="26" Margin="0,0,4,0" />
                                <Button Content="适应屏幕" Style="{StaticResource Button.Secondary}" Height="26" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent" />

                    <!-- 下半部分：关联加工参数表格 -->
                    <GroupBox Grid.Row="2" Header="特征几何参数列表">
                        <DataGrid x:Name="GridFeatureParams"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  SelectionUnit="FullRow"
                                  CanUserResizeRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="参数名称" Binding="{Binding Name}" Width="120" IsReadOnly="True" />
                                <DataGridTextColumn Header="设计值" Binding="{Binding DesignValue}" Width="90" EditingElementStyle="{StaticResource DataGrid.Editing.TextBox}" />
                                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60" IsReadOnly="True" ElementStyle="{StaticResource DataGrid.Element.TextCenter}" />
                                <DataGridTextColumn Header="上公差" Binding="{Binding UpperTol}" Width="80" EditingElementStyle="{StaticResource DataGrid.Editing.TextBox}" />
                                <DataGridTextColumn Header="下公差" Binding="{Binding LowerTol}" Width="80" EditingElementStyle="{StaticResource DataGrid.Editing.TextBox}" />
                                <DataGridTextColumn Header="备注说明" Binding="{Binding Note}" Width="*" MinWidth="120" EditingElementStyle="{StaticResource DataGrid.Editing.TextBox}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>

                <!-- 分割线 -->
                <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- ================= 右侧：属性检查器（Property Grid） ================= -->
                <GroupBox Grid.Column="4" Header="属性检查器 (Inspector)">
                    <ScrollViewer Style="{StaticResource ScrollViewer.Base}"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="2">

                            <!-- 分组 1：基础标识 -->
                            <Expander Header="1. 构件基础信息" IsExpanded="True" Margin="0,0,0,6">
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="70" />
                                        <ColumnDefinition Width="*" MinWidth="110" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="特征编号" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="FEAT-2026-G19" Margin="0,2" />

                                    <TextBlock Grid.Row="1" Text="构件类别" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0" Margin="0,2">
                                        <ComboBoxItem Content="传动齿轮" />
                                        <ComboBoxItem Content="转轴类" />
                                        <ComboBoxItem Content="壳体支承" />
                                    </ComboBox>

                                    <TextBlock Grid.Row="2" Text="设计负责人" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="机械所 · 杜工" Margin="0,2" />
                                </Grid>
                            </Expander>

                            <!-- 分组 2：材料与力学 -->
                            <Expander Header="2. 材料与热处理" IsExpanded="True" Margin="0,0,0,6">
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="70" />
                                        <ColumnDefinition Width="*" MinWidth="110" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="材料牌号" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" SelectedIndex="1" Margin="0,2">
                                        <ComboBoxItem Content="20CrMnTi 渗碳钢" />
                                        <ComboBoxItem Content="40Cr 调质钢" />
                                        <ComboBoxItem Content="42CrMo 结构钢" />
                                    </ComboBox>

                                    <TextBlock Grid.Row="1" Text="硬度要求" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="HRC 58-62 (齿面)" Margin="0,2" />

                                    <TextBlock Grid.Row="2" Text="计算质量" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="0.842 kg" IsReadOnly="True" Margin="0,2" />
                                </Grid>
                            </Expander>

                            <!-- 分组 3：制造工艺与质检 -->
                            <Expander Header="3. 表面工艺与质检" IsExpanded="True" Margin="0,0,0,6">
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="70" />
                                        <ColumnDefinition Width="*" MinWidth="110" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="粗糙度" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="Ra 0.8 μm" Margin="0,2" />

                                    <TextBlock Grid.Row="1" Text="防锈包装" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0" Margin="0,2">
                                        <ComboBoxItem Content="气相防锈袋 + 油封" />
                                        <ComboBoxItem Content="浸渍防锈油" />
                                    </ComboBox>

                                    <TextBlock Grid.Row="2" Text="质检等级" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="0" Margin="0,2">
                                        <ComboBoxItem Content="A 级 (100% 全检)" />
                                        <ComboBoxItem Content="B 级 (抽检 10%)" />
                                    </ComboBox>
                                </Grid>
                            </Expander>

                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>
            </Grid>

            <!-- 4. 底部状态与诊断条 -->
            <Border Grid.Row="3"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="0,8,0,0"
                    Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="系统状态：已加载 38 个装配特征 · 拓扑结构正常 · 质量矩阵收敛"
                                   Style="{StaticResource Text.Caption}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="视口比例: 100% | 坐标: (X: 120.5, Y: 0.0, Z: 85.0)"
                                   Style="{StaticResource Text.Caption}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
