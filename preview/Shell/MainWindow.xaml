<Window x:Class="WpfStylePreview.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF UI Skills · 案例中心"
        Width="1380" Height="880"
        MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="NavItem" TargetType="{x:Type ListBoxItem}"
               BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="8,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ToolTip" Value="{Binding Subtitle}" />
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ================= 左侧导航 ================= -->
        <Border DockPanel.Dock="Left"
                Width="256"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28"
                                Background="{StaticResource Brush.Accent}"
                                CornerRadius="{StaticResource Radius.Card}"
                                VerticalAlignment="Center">
                            <TextBlock Text="W" Foreground="{StaticResource Brush.OnAccent}"
                                       FontSize="{StaticResource FontSize.Section}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="WPF UI Skills" Style="{StaticResource Text.Title}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="工程桌面 UI 规范与案例" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,14,0,0" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Padding="18,10"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="三档密度：紧凑 / 中等 / 宽松" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="右上角切换，整窗即时生效" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="NavList"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,4,0,10"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="{StaticResource FontSize.Caption}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               Margin="18,12,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="{StaticResource FontSize.Body}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Primary}" />
                                <TextBlock Text="{Binding Subtitle}"
                                           Style="{StaticResource Text.Caption}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Subtitle}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= 右侧内容 ================= -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Style="{StaticResource Text.Title}"
                                   FontWeight="SemiBold" Text="案例总览" />
                        <TextBlock x:Name="PageSubtitle" Style="{StaticResource Text.Caption}"
                                   Margin="0,2,0,0" Text="规范、密度与全部业务案例入口" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="密度" Style="{StaticResource Text.Caption}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="DensityCombo" Width="96" Margin="0,0,10,0"
                                  SelectedIndex="1"
                                  SelectionChanged="DensityCombo_SelectionChanged"
                                  ToolTip="切换紧凑 / 中等 / 宽松三档密度">
                            <ComboBoxItem Content="紧凑" />
                            <ComboBoxItem Content="中等" />
                            <ComboBoxItem Content="宽松" />
                        </ComboBox>
                        <Button x:Name="StandaloneButton" Content="独立窗口"
                                Style="{StaticResource Button.Secondary.Small}"
                                Click="StandaloneButton_Click"
                                ToolTip="在新窗口打开当前案例，便于截图或并排对比" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="PageHost" Grid.Row="1" />
        </Grid>
    </DockPanel>
</Window>
