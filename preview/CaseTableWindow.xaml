<!--
    案例 2：数据表格（紧凑布局）

    演示点：
    1. 表格 + 工具栏 + 分页条的标准骨架；
    2. 行高 26px、表头 28px，一屏能看到更多行；
    3. 工具栏左搜索右操作，主次分明、危险操作隔离；
    4. 状态与分页在底部一行，不与内容区抢高度。
-->
<Window x:Class="WpfStylePreview.CaseTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="案例 · 数据表格"
        Width="1080" Height="620"
        MinWidth="780" MinHeight="360"
        WindowStartupLocation="CenterScreen">

    <Border Background="{StaticResource Brush.WindowBackground}">
        <Grid Margin="{StaticResource Layout.WindowPadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 页头 -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,10"
                    Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="图纸清单" Style="{StaticResource Text.Title}" FontWeight="SemiBold" />
                    <TextBlock Text="共 128 条"
                               Style="{StaticResource Text.Caption}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 工具栏 -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="{StaticResource Layout.InputMinWidth}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 搜索框 -->
                <TextBox Grid.Column="0" MinWidth="180" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="导出" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="重新翻译" Style="{StaticResource Button.Secondary}" Margin="0,0,16,0" />
                    <Button Content="删除" Style="{StaticResource Button.Danger}" />
                </StackPanel>
            </Grid>

            <!-- 表格：占 * 行，数据多时自身滚动 -->
            <DataGrid x:Name="GridDrawings"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      CanUserResizeRows="False"
                      SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="图号" Binding="{Binding Code}" Width="100" />
                    <DataGridTextColumn Header="图名" Binding="{Binding Name}" Width="*" MinWidth="180" />
                    <DataGridTextColumn Header="文本数" Binding="{Binding TextCount}" Width="80" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" />
                    <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*" MinWidth="160" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- 底部分页条：状态左、分页右，同一行但互不挤压 -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="已选择 1 项 · 术语库命中 12 条"
                           Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Text.Small}" Content="上一页" Margin="0,0,4,0" IsEnabled="False" />
                    <TextBlock Text="1 / 13" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Button.Text.Small}" Content="下一页" />
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
