<UserControl x:Class="WpfStylePreview.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource Brush.WindowBackground}">
        <Grid Margin="{StaticResource Layout.WindowPadding}">
            <Grid.RowDefinitions>
                <!-- 1. 页头控制栏 -->
                <RowDefinition Height="Auto" />
                <!-- 2. KPI 指标卡片网格 -->
                <RowDefinition Height="Auto" />
                <!-- 3. 主监控内容区 -->
                <RowDefinition Height="*" />
                <!-- 4. 底部状态与运维操作 -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. 页头控制栏 -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,10"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="图纸协同处理与制造调度看板" Style="{StaticResource Text.Title}" FontWeight="SemiBold" />
                        <Border Background="{StaticResource Brush.Success.Subtle}"
                                CornerRadius="{StaticResource Radius.Small}"
                                Padding="6,2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="实时监控运行中"
                                       FontSize="{StaticResource FontSize.Caption}"
                                       Foreground="{StaticResource Brush.Success}"
                                       FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <!-- 右侧控制 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="统计周期：" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Width="100" Height="28" SelectedIndex="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <ComboBoxItem Content="今日实时" />
                            <ComboBoxItem Content="最近 7 天" />
                            <ComboBoxItem Content="本月累计" />
                        </ComboBox>
                        <Button Content="刷新数据" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" Click="BtnRefresh_Click" />
                        <Button Content="导出报表" Style="{StaticResource Button.Secondary}" Click="BtnExport_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. 顶部 4 组 KPI 指标卡片 -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource Layout.ColumnGap}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource Layout.ColumnGap}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource Layout.ColumnGap}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- KPI 1：今日图纸总吞吐 -->
                <Border Grid.Column="0"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}"
                        Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="今日图纸处理总量" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="1,248" FontSize="{StaticResource FontSize.Display}" FontWeight="Bold" Margin="0,4,0,2" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="较昨日 " Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="+15.4% ↑" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Success}" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- KPI 2：自动合规率 -->
                <Border Grid.Column="2"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}"
                        Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="智能校验通过率" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="98.2%" FontSize="{StaticResource FontSize.Display}" FontWeight="Bold" Foreground="{StaticResource Brush.Success}" Margin="0,4,0,2" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="几何无干涉 / 术语命中率高" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- KPI 3：待复核告警 -->
                <Border Grid.Column="4"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}"
                        Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="待人工干预项" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="6" FontSize="{StaticResource FontSize.Display}" FontWeight="Bold" Foreground="{StaticResource Brush.Danger}" Margin="0,4,0,2" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="含 2 处尺寸公差冲突" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Danger}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- KPI 4：集群节点耗时 -->
                <Border Grid.Column="6"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}"
                        Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="单图平均转换耗时" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="1.42 s" FontSize="{StaticResource FontSize.Display}" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}" Margin="0,4,0,2" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="4 节点并行执行" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. 主监控内容区：左（队列与进度）+ 右（告警流） -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="360" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：实时队列与工作节点 -->
                <GroupBox Grid.Column="0" Header="实时处理任务流水线">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 当前批次进度卡片 -->
                        <Border Grid.Row="0"
                                Background="{StaticResource Brush.SurfaceSunken}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Small}"
                                Padding="12,10"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="当前运行批次：BATCH-20261107-04" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                    <TextBlock Text="78% (39/50)" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Height="8" Value="78" Margin="0,0,0,6" />
                                <Grid>
                                    <TextBlock Text="正在处理：DOC-0482_装配剖面图.dwg" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="预估剩余 12 秒" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 队列明细列表 -->
                        <ListBox x:Name="ListTaskQueue" Grid.Row="1">
                            <ListBoxItem Content="[执行中] DOC-0482_装配剖面图.dwg · 线程 #2 正在生成 PDF 标定层" IsSelected="True" />
                            <ListBoxItem Content="[排队中] PRT-1008_管路固定卡箍.dwg · 等待特征提取" />
                            <ListBoxItem Content="[排队中] PRT-1009_轴承端盖.dwg · 等待特征提取" />
                            <ListBoxItem Content="[已完成] PRT-1001_箱体底座.dwg · 耗时 1.1s (校验合格)" />
                            <ListBoxItem Content="[已完成] PRT-1002_输入高速轴.dwg · 耗时 0.9s (校验合格)" />
                            <ListBoxItem Content="[已完成] PRT-1003_斜齿小齿轮.dwg · 耗时 1.3s (校验合格)" />
                        </ListBox>
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- 右侧：异常与审计告警事件表格 -->
                <GroupBox Grid.Column="2" Header="系统异常与质检告警流">
                    <DataGrid x:Name="GridAlerts"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="60" ElementStyle="{StaticResource DataGrid.Element.TextCenter}" />
                            <DataGridTextColumn Header="发生时间" Binding="{Binding Timestamp}" Width="80" ElementStyle="{StaticResource DataGrid.Element.TextCenter}" />
                            <DataGridTextColumn Header="图纸/来源" Binding="{Binding Source}" Width="120" />
                            <DataGridTextColumn Header="告警与诊断描述" Binding="{Binding Message}" Width="*" MinWidth="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>

            <!-- 4. 底部运维状态栏 -->
            <Border Grid.Row="3"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="0,8,0,0"
                    Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="调度引擎状态：正常 (CPU 24% · 内存 3.2 GB / 16 GB · 磁盘 I/O 18 MB/s)"
                               Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Text.Small}" Content="清空已完成队列" Margin="0,0,8,0" Click="BtnClearFinished_Click" />
                        <Button Style="{StaticResource Button.Text.Small}" Content="查看运行日志" Click="BtnExportLog_Click" />
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>
