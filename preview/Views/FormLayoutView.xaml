<UserControl x:Class="WpfStylePreview.Views.FormLayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource Layout.WindowPadding}">

            <TextBlock Text="表单对齐" Style="{StaticResource Text.Title}" FontWeight="SemiBold" />
            <TextBlock Text="标签与控件必须共享同一条左基线：宽面板用两列，窄面板改单列。"
                       Style="{StaticResource Text.Caption}" Margin="0,3,0,10" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 宽面板：标签在左、控件在右 -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="宽面板（≥ 520 DIP）" Style="{StaticResource Text.Section}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="标签在左、控件在右；所有行共用一个 Grid，列宽只定义一次。"
                                   Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="{StaticResource Layout.FormLabelMinWidth}" />
                                <ColumnDefinition Width="*" MinWidth="{StaticResource Layout.InputMinWidth}" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="服务地址" Style="{StaticResource Text.Label}" />
                            <TextBox Grid.Column="1" Margin="0,3" Text="http://127.0.0.1:8080/v1" />

                            <TextBlock Grid.Row="1" Text="模型名称" Style="{StaticResource Text.Label}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Text="demo-translation-model" />

                            <TextBlock Grid.Row="2" Text="超时（秒）" Style="{StaticResource Text.Label}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Text="300" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 窄面板：标签在上、控件在下 -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="窄面板 / 停靠窗（&lt; 520 DIP）" Style="{StaticResource Text.Section}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="标签在上、控件在下，两者都从左边开始；不依赖左右列宽。"
                                   Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />

                        <Border Width="300" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Background="{StaticResource Brush.SurfaceAlt}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Card}"
                                Padding="{DynamicResource Layout.CardPadding}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource FormStack}">
                                    <TextBlock Text="服务地址" Style="{StaticResource Text.FieldLabel}" />
                                    <TextBox Text="http://127.0.0.1:8080/v1" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormStack}">
                                    <TextBlock Text="模型名称" Style="{StaticResource Text.FieldLabel}" />
                                    <TextBox Text="demo-translation-model" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormStack}">
                                    <TextBlock Text="超时（秒）" Style="{StaticResource Text.FieldLabel}" />
                                    <TextBox Text="300" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="对齐检查" Style="{StaticResource Text.Section}" FontWeight="SemiBold" />
                    <TextBlock Text="1. 标签和控件放在同一个 Grid 里，列定义只写一次；不要每行一个 Grid。"
                               Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
                    <TextBlock Text="2. 标签列用 Auto + MinWidth，输入列用 * + MinWidth；不要写死输入框 Width。"
                               Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                    <TextBlock Text="3. 输入框、下拉框内部文字保持左对齐（不要设 HorizontalContentAlignment=Center；数字列除外）。"
                               Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                    <TextBlock Text="4. 宿主宽度可能小于 520 DIP 时，改用单列表单（FormStack + Text.FieldLabel）。"
                               Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                    <TextBlock Text="5. GroupBox 标题与内容使用同一内边距，共享左基线。"
                               Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
