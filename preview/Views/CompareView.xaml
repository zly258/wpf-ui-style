<!--
    双栏对照 + 日志（紧凑布局）

    演示点：
    1. 左右对照面板 + 底部日志区，主内容占 * 行，日志固定高度；
    2. 对照区与日志区各自滚动，不互相抢高度；
    3. 面板头是工具栏行：标题左、图标操作右；
    4. 底部操作栏固定在窗口底部，按钮不被内容顶出。
-->
<UserControl x:Class="WpfStylePreview.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource Brush.WindowBackground}">
        <Grid Margin="{StaticResource Layout.WindowPadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 页头 -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,10"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="总装图.dwg · 文本对照" Style="{StaticResource Text.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="上一处" Style="{StaticResource Button.Secondary.Small}" ToolTip="上一个差异 (F3)" Margin="0,0,4,0" />
                        <Button Content="下一处" Style="{StaticResource Button.Secondary.Small}" ToolTip="下一个差异 (F4)" Margin="0,0,4,0" />
                        <Button Content="复制译文" Style="{StaticResource Button.Secondary.Small}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 对照区：左右两栏平分，各自滚动 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource Layout.ColumnGap}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：原文 -->
                <Border Grid.Column="0"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}"
                        Background="{StaticResource Brush.Surface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource Brush.SurfaceAlt}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                                Padding="8,6">
                            <TextBlock Text="原文 · 简体中文" Style="{StaticResource Text.Label}" />
                        </Border>

                        <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewer.Base}"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="8,6">
                            <TextBlock Style="{StaticResource Text.Body}"
                                       Text="技术要求&#x0a;1. 装配前去除所有毛刺与飞边。&#x0a;2. 未注倒角 C0.5，未注圆角 R2。&#x0a;3. 全部螺纹孔在装配前攻丝。&#x0a;4. 图中未注明的尺寸公差按 GB/T 1804-m。&#x0a;5. 本图样尺寸以毫米计。"
                                       ToolTip="长文本用 ToolTip 提供完整内容" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 右：译文 -->
                <Border Grid.Column="2"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}"
                        Background="{StaticResource Brush.Surface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource Brush.SurfaceAlt}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1"
                                Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="译文 · 英语" Style="{StaticResource Text.Label}" />
                                <TextBlock Grid.Column="1" Text="术语库 12 / 12"
                                           Style="{StaticResource Text.Caption}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewer.Base}"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="8,6">
                            <TextBlock Style="{StaticResource Text.Body}"
                                       Text="Technical requirements&#x0a;1. Remove all burrs and flash before assembly.&#x0a;2. Unspecified chamfer C0.5, unspecified fillet R2.&#x0a;3. Tap all threaded holes before assembly.&#x0a;4. Unspecified dimensional tolerances per GB/T 1804-m.&#x0a;5. Dimensions are in millimetres."
                                       ToolTip="长文本用 ToolTip 提供完整内容" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 日志区：固定高度，自身滚动 -->
            <GroupBox Grid.Row="2" Header="处理日志" Margin="0,10,0,0">
                <TextBox Style="{StaticResource TextBox.Code}"
                         Height="110"
                         VerticalAlignment="Top"
                         Text="[10:00:01] 开始处理 A-001 总装图.dwg&#x0a;[10:00:02] 提取文本 42 条，跳过 3 条已为目标语言&#x0a;[10:00:03] 调用翻译服务：http://127.0.0.1:8080/v1&#x0a;[10:00:05] 已翻译 39 条，术语库命中 12 条"
                         ToolTip="完整日志" />
            </GroupBox>

            <!-- 底部操作栏 -->
            <Border Grid.Row="3"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="0,10,0,0"
                    Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="就绪 · 39 / 42 条已翻译"
                               Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="关闭" IsCancel="True" Margin="0,0,8,0" />
                        <Button Content="写回图纸" Style="{StaticResource Button.Primary}" IsDefault="True" MinWidth="88" />
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>
