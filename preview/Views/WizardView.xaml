<UserControl x:Class="WpfStylePreview.Views.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource Brush.WindowBackground}">
        <Grid Margin="{StaticResource Layout.WindowPadding}">
            <Grid.RowDefinitions>
                <!-- 1. 顶部向导流程步骤条 -->
                <RowDefinition Height="Auto" />
                <!-- 2. 中间步骤内容区 -->
                <RowDefinition Height="*" />
                <!-- 3. 底部向导步进操作栏 -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. 顶部步骤条指示器 -->
            <Border Grid.Row="0"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}"
                    Padding="16,12"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 步骤 1 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border x:Name="Step1Badge"
                                Width="24" Height="24"
                                CornerRadius="12"
                                Background="{StaticResource Brush.Accent}"
                                Margin="0,0,8,0">
                            <TextBlock x:Name="Step1Number" Text="1" Foreground="{StaticResource Brush.OnAccent}"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="第 1 步" Style="{StaticResource Text.Caption}" />
                            <TextBlock x:Name="Step1Title" Text="选择源图纸" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 连接线 1-2 -->
                    <Border Grid.Column="1" Width="40" Height="2"
                            Background="{StaticResource Brush.Border}"
                            VerticalAlignment="Center" Margin="8,0" />

                    <!-- 步骤 2 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border x:Name="Step2Badge"
                                Width="24" Height="24"
                                CornerRadius="12"
                                Background="{StaticResource Brush.SurfaceAlt}"
                                Margin="0,0,8,0">
                            <TextBlock x:Name="Step2Number" Text="2" Foreground="{StaticResource Brush.Text.Secondary}"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="第 2 步" Style="{StaticResource Text.Caption}" />
                            <TextBlock x:Name="Step2Title" Text="配置转换规则" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text.Secondary}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 连接线 2-3 -->
                    <Border Grid.Column="3" Width="40" Height="2"
                            Background="{StaticResource Brush.Border}"
                            VerticalAlignment="Center" Margin="8,0" />

                    <!-- 步骤 3 -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border x:Name="Step3Badge"
                                Width="24" Height="24"
                                CornerRadius="12"
                                Background="{StaticResource Brush.SurfaceAlt}"
                                Margin="0,0,8,0">
                            <TextBlock x:Name="Step3Number" Text="3" Foreground="{StaticResource Brush.Text.Secondary}"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="第 3 步" Style="{StaticResource Text.Caption}" />
                            <TextBlock x:Name="Step3Title" Text="确认与批处理" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text.Secondary}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. 中间步骤内容容器 -->
            <Border Grid.Row="1"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}"
                    Padding="20,16">
                <Grid>
                    <!-- ================= 第 1 步页面 ================= -->
                    <Grid x:Name="PanelStep1" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="选择待批处理的工程图纸与模型文件" Style="{StaticResource Text.Section}" FontWeight="SemiBold" />
                            <TextBlock Text="支持 Autodesk Inventor (.idw/.dwg/.iam/.ipt) 文件批量导入解析。"
                                       Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="{StaticResource Layout.FormLabelMinWidth}" />
                                <ColumnDefinition Width="*" MinWidth="{StaticResource Layout.InputMinWidth}" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 源工程目录 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="源工程目录" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="D:/Demo/Mechanical-Assembly\Drawings" Margin="0,3,8,3" VerticalAlignment="Center" />
                            <Button Grid.Row="0" Grid.Column="2" Content="浏览..." Style="{StaticResource Button.Secondary}" VerticalAlignment="Center" />

                            <!-- 扫描模式 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="包含子目录" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                <CheckBox Content="递归遍历所有子文件夹" IsChecked="True" Margin="0,0,16,0" />
                                <CheckBox Content="自动跳过只读库文件" IsChecked="True" />
                            </StackPanel>

                            <!-- 扫描到的文件列表 -->
                            <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Header="已检索到的待处理文件清单 (12 份)">
                                <ListBox x:Name="ListFiles">
                                    <ListBoxItem Content="DOC-0001_示例装配体.dwg (总装图 · 12.4 MB)" IsSelected="True" />
                                    <ListBoxItem Content="PRT-1001_箱体底座.dwg (铸造件 · 6.8 MB)" />
                                    <ListBoxItem Content="PRT-1002_输入高速轴.dwg (轴类件 · 3.2 MB)" />
                                    <ListBoxItem Content="PRT-1003_斜齿小齿轮.dwg (齿轮类 · 2.9 MB)" />
                                    <ListBoxItem Content="PRT-1004_大齿轮.dwg (齿轮类 · 4.1 MB)" />
                                    <ListBoxItem Content="PRT-1005_输出低速轴.dwg (轴类件 · 3.5 MB)" />
                                </ListBox>
                            </GroupBox>
                        </Grid>
                    </Grid>

                    <!-- ================= 第 2 步页面 ================= -->
                    <Grid x:Name="PanelStep2" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="规则配置与图纸属性映射" Style="{StaticResource Text.Section}" FontWeight="SemiBold" />
                            <TextBlock Text="设定图层映射、标题栏属性提取及尺寸公差转换策略。"
                                       Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewer.Base}" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <GroupBox Header="1. 标题栏属性字段提取映射" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="{StaticResource Layout.FormLabelMinWidth}" />
                                            <ColumnDefinition Width="*" MinWidth="{StaticResource Layout.InputMinWidth}" />
                                            <ColumnDefinition Width="{StaticResource Layout.ColumnGap}" />
                                            <ColumnDefinition Width="Auto" MinWidth="{StaticResource Layout.FormLabelMinWidth}" />
                                            <ColumnDefinition Width="*" MinWidth="{StaticResource Layout.InputMinWidth}" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="文档编号对应字段" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="&lt;Drawing Number&gt;" Margin="0,3" />

                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="图名对应字段" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="0" Grid.Column="4" Text="&lt;Title&gt;" Margin="0,3" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="材料字段" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="&lt;Material&gt;" Margin="0,3" />

                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="比例字段" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="1" Grid.Column="4" Text="&lt;Scale&gt;" Margin="0,3" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="设计者字段" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="&lt;Author&gt;" Margin="0,3" />

                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="版本代号" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="2" Grid.Column="4" Text="&lt;Revision&gt;" Margin="0,3" />
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="2. 单位制与输出选项">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="{StaticResource Layout.FormLabelMinWidth}" />
                                            <ColumnDefinition Width="*" MinWidth="{StaticResource Layout.InputMinWidth}" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="长度单位基准" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Row="0" Grid.Column="1" SelectedIndex="0" Margin="0,3">
                                            <ComboBoxItem Content="毫米 (Millimeter - mm)" />
                                            <ComboBoxItem Content="英寸 (Inch - in)" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="格式转换目标" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0" Margin="0,3">
                                            <ComboBoxItem Content="保持原 DWG 格式并生成 PDF 副本" />
                                            <ComboBoxItem Content="转为 AutoCAD 2018 DXF 格式" />
                                            <ComboBoxItem Content="仅抽取 BOM 明细表为 XLSX" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="异常中断策略" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                            <RadioButton Content="遇错误跳过并记录日志" IsChecked="True" Margin="0,0,16,0" />
                                            <RadioButton Content="遇严重错误立即弹窗暂停" />
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ================= 第 3 步页面 ================= -->
                    <Grid x:Name="PanelStep3" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="确认批处理任务配置并开始执行" Style="{StaticResource Text.Section}" FontWeight="SemiBold" />
                            <TextBlock Text="核对以下任务摘要，点击“开始批处理”将启动后台转换队列。"
                                       Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- 摘要卡片 -->
                        <Border Grid.Row="1"
                                Background="{StaticResource Brush.SurfaceSunken}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Small}"
                                Padding="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="待处理图纸数：" Style="{StaticResource Text.Label}" />
                                    <TextBlock Grid.Column="1" Text="12 份图纸（包含 1 份总装图，11 份零部件图）" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="输出目标目录：" Style="{StaticResource Text.Label}" />
                                    <TextBlock Grid.Column="1" Text="D:/Demo/Mechanical-Assembly\Export_20261107" Style="{StaticResource Text.Body}" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="转换任务模式：" Style="{StaticResource Text.Label}" />
                                    <TextBlock Grid.Column="1" Text="DWG 几何校准 + 标题栏映射提取 + 矢量 PDF 导出" Style="{StaticResource Text.Body}" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="预估总耗时：" Style="{StaticResource Text.Label}" />
                                    <TextBlock Grid.Column="1" Text="约 18 ~ 25 秒（多核并发处理）" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Accent}" />
                                </Grid>

                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,8,0,12" />

                                <CheckBox Content="执行前自动备份原始 DWG 图纸到 _backup 目录" IsChecked="True" Margin="0,0,0,6" />
                                <CheckBox Content="处理完成后自动打开输出文件夹" IsChecked="True" />
                            </StackPanel>
                        </Border>

                        <!-- 进度展示（初始空） -->
                        <StackPanel x:Name="PanelProgress" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="正在批处理第 4 / 12 份图纸..." Style="{StaticResource Text.Caption}" />
                                <TextBlock Text="33%" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Height="8" Value="33" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. 底部步进控制栏 -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="0,12,0,0"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧步骤引导说明 -->
                    <TextBlock x:Name="TxtStepGuide"
                               Text="请确认选择需要处理的文件后，点击“下一步”进行规则设定。"
                               Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" />

                    <!-- 右侧控制按钮组 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnPrev"
                                Content="上一步"
                                Style="{StaticResource Button.Secondary}"
                                Margin="0,0,8,0"
                                IsEnabled="False"
                                Click="BtnPrev_Click" />
                        <Button x:Name="BtnNext"
                                Content="下一步"
                                Style="{StaticResource Button.Primary}"
                                Margin="0,0,8,0"
                                Click="BtnNext_Click" />
                        <Button Content="取消"
                                Style="{StaticResource Button.Secondary}"
                                Click="BtnCancel_Click" />
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>
