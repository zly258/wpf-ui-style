<UserControl x:Class="WpfStylePreview.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 首页案例卡片：沿用按钮状态契约，只把高度/对齐改成卡片形态 -->
        <Style x:Key="CaseCard" TargetType="{x:Type Button}"
               BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Width" Value="268" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource Layout.WindowPadding}">

            <!-- 产品与规范定位 -->
            <Border Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="WPF UI Skills"
                                   FontSize="{StaticResource FontSize.Display}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text.Primary}" />
                        <TextBlock Text="面向工程桌面与 CAD 插件的 WPF 视觉规范、三档密度与自动化校验。"
                                   Style="{StaticResource Text.Body}"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   Margin="0,6,0,0" />

                        <WrapPanel Margin="0,12,0,0">
                            <Border Background="{StaticResource Brush.Accent.Subtle}"
                                    CornerRadius="{StaticResource Radius.Pill}"
                                    Padding="{DynamicResource Layout.BadgePadding}"
                                    Margin="0,0,8,0">
                                <TextBlock Text="默认中等密度"
                                           FontSize="{StaticResource FontSize.Caption}"
                                           Foreground="{StaticResource Brush.Accent}" />
                            </Border>
                            <Border Background="{StaticResource Brush.Accent.Subtle}"
                                    CornerRadius="{StaticResource Radius.Pill}"
                                    Padding="{DynamicResource Layout.BadgePadding}"
                                    Margin="0,0,8,0">
                                <TextBlock Text="3 档密度"
                                           FontSize="{StaticResource FontSize.Caption}"
                                           Foreground="{StaticResource Brush.Accent}" />
                            </Border>
                            <Border Background="{StaticResource Brush.Success.Subtle}"
                                    CornerRadius="{StaticResource Radius.Pill}"
                                    Padding="{DynamicResource Layout.BadgePadding}">
                                <TextBlock Text="0 Error 质量门禁"
                                           FontSize="{StaticResource FontSize.Caption}"
                                           Foreground="{StaticResource Brush.Success}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                        <Button Content="从基础控件开始" Style="{StaticResource Button.Primary}"
                                Tag="controls" Click="CaseButton_Click"
                                HorizontalAlignment="Stretch" />
                        <Button Content="打开可编辑表格" Style="{StaticResource Button.Secondary}"
                                Tag="editable-table" Click="CaseButton_Click"
                                Margin="0,8,0,0" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 三条核心约束 -->
            <UniformGrid Columns="3" Margin="0,12,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="密度只改尺寸" Style="{StaticResource Text.Section}" FontWeight="SemiBold" />
                        <TextBlock Text="紧凑 / 中等 / 宽松只改变控件高度、行高与内边距；颜色、字号、16px 勾选框保持不变。"
                                   Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="状态契约显式化" Style="{StaticResource Text.Section}" FontWeight="SemiBold" />
                        <TextBlock Text="改背景必改前景；禁用不使用 Opacity；选中 + 悬停用 MultiTrigger，避免白字压浅底。"
                                   Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="不截断、不遮挡" Style="{StaticResource Text.Section}" FontWeight="SemiBold" />
                        <TextBlock Text="标签列 Auto + MinWidth、输入列 * + MinWidth；长值配 ToolTip；窗口只保留一层垂直滚动。"
                                   Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 全部案例入口 -->
            <TextBlock Text="全部案例" Style="{StaticResource Text.Section}"
                       FontWeight="SemiBold" Margin="0,16,0,8" />
            <ItemsControl ItemsSource="{Binding Cases}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CaseCard}"
                                Tag="{Binding Key}" Click="CaseButton_Click">
                            <StackPanel>
                                <TextBlock Text="{Binding Category}"
                                           FontSize="{StaticResource FontSize.Caption}"
                                           Foreground="{StaticResource Brush.Text.Secondary}" />
                                <TextBlock Text="{Binding Title}"
                                           Style="{StaticResource Text.Section}"
                                           FontWeight="SemiBold" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding Subtitle}"
                                           Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="打开 →"
                                           FontSize="{StaticResource FontSize.Caption}"
                                           Foreground="{StaticResource Brush.Accent}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="左侧导航按分类列出全部案例；右上角可在紧凑 / 中等 / 宽松之间实时切换密度。"
                       Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
