<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        ============================================================
        Density 紧凑 (Compact)
        ============================================================
        用于：工程插件工具条、属性面板、数据密集型表格、嵌入式停靠窗。

        只有「尺寸 / 内边距 / 行高」随密度变化，颜色与字号保持不变。
        这样切换密度不会破坏对比度、不会让文字忽大忽小，只改变呼吸感。

        所有键名与 Tokens.xaml 中的缺省值一致。控件通过
        {DynamicResource Layout.*} 读取，运行时替换本字典即可整体换挡。

        换挡方式（任选其一）：
          1. App.xaml 合并 Theme.Compact.xaml（整包入口）；
          2. 运行时替换合并字典：Application.Current.Resources
             .MergedDictionaries.Add(new ResourceDictionary { Source = ...Density.Compact.xaml });
    -->

    <sys:String x:Key="Density.Profile">compact</sys:String>

    <!-- 控件高度 -->
    <sys:Double x:Key="Layout.ControlHeight">26</sys:Double>
    <sys:Double x:Key="Layout.ControlHeight.Small">24</sys:Double>
    <sys:Double x:Key="Layout.ControlHeight.Large">32</sys:Double>

    <!-- 数据行 / 表头 -->
    <sys:Double x:Key="Layout.RowHeight">24</sys:Double>
    <sys:Double x:Key="Layout.HeaderHeight">26</sys:Double>

    <!-- 按钮 -->
    <sys:Double x:Key="Layout.ButtonMinWidth">56</sys:Double>
    <sys:Double x:Key="Layout.ButtonMinWidth.Small">40</sys:Double>
    <Thickness x:Key="Layout.ButtonPadding">10,0</Thickness>
    <Thickness x:Key="Layout.ButtonPadding.Small">6,0</Thickness>

    <!-- 输入 -->
    <Thickness x:Key="Layout.InputPadding">6,0</Thickness>
    <Thickness x:Key="Layout.InputPadding.Multiline">6,4</Thickness>
    <Thickness x:Key="Layout.ComboBoxPadding">6,0,22,0</Thickness>
    <Thickness x:Key="Layout.ComboBoxItemPadding">6,3</Thickness>
    <Thickness x:Key="Layout.DatePickerPadding">6,0,28,0</Thickness>

    <!-- 列表 / 菜单 -->
    <Thickness x:Key="Layout.ListItemPadding">6,4</Thickness>
    <Thickness x:Key="Layout.ListViewItemPadding">2,1</Thickness>
    <Thickness x:Key="Layout.MenuItemPadding">7,4</Thickness>

    <!-- 容器 / 间距 -->
    <Thickness x:Key="Layout.WindowPadding">8</Thickness>
    <Thickness x:Key="Layout.GroupPadding">8</Thickness>
    <Thickness x:Key="Layout.CardPadding">8</Thickness>
    <Thickness x:Key="Layout.FormRowMargin">0,2,0,2</Thickness>
    <Thickness x:Key="Layout.SectionMargin">0,0,0,6</Thickness>

    <!-- 标签页 -->
    <Thickness x:Key="Layout.TabPadding">10,4</Thickness>
    <Thickness x:Key="Layout.TabMargin">0,0,2,0</Thickness>

    <!-- 其它 -->
    <Thickness x:Key="Layout.TooltipPadding">6,3</Thickness>
    <Thickness x:Key="Layout.BadgePadding">6,1</Thickness>
    <Thickness x:Key="Layout.ExpanderHeaderPadding">8,4</Thickness>
    <Thickness x:Key="Layout.ExpanderContentPadding">8,5</Thickness>
    <Thickness x:Key="Layout.ToolBarPadding">4,2</Thickness>
    <sys:Double x:Key="Layout.ToolBarHeight">38</sys:Double>
    <sys:Double x:Key="Layout.ProgressBarHeight">6</sys:Double>

    <sys:Double x:Key="Layout.TagHeight">22</sys:Double>
    <sys:Double x:Key="Layout.IconButton.Micro">22</sys:Double>
    <sys:Double x:Key="Layout.IconButton.Small">24</sys:Double>
    <sys:Double x:Key="Layout.IconButton.Large">28</sys:Double>

</ResourceDictionary>
