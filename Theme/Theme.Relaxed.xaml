<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        宽松密度整包入口。
        适合：触屏 / 演示 / 培训 / 低信息密度窗口。
        用法与 Theme.xaml 相同，只替换 Source 文件名。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
        <ResourceDictionary Source="Controls.xaml" />
        <ResourceDictionary Source="DataControls.xaml" />
        <ResourceDictionary Source="Icons.xaml" />
        <ResourceDictionary Source="Extras.xaml" />
        <!-- 密度档案必须最后合并：控件字典内部又合并了 Tokens（中等兜底），
             只有最后合并才能让密度键在查找时优先命中。 -->
        <ResourceDictionary Source="Density.Relaxed.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
