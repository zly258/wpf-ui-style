<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <!--
        补充控件样式：Slider / DatePicker / RichTextBox / ToggleButton /
        ToggleSwitch / Menu / ToolBar / Card / Badge。
        全部沿用 Tokens.xaml 的令牌，不引入任何新色值、新字体。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
        <!-- 模板/BasedOn 通过 StaticResource 引用 Icons/Controls 中的资源，
             必须在本文件作用域内可见 -->
        <ResourceDictionary Source="Icons.xaml" />
        <ResourceDictionary Source="Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================================================
         Card / Badge
         ============================================================ -->
    <Style x:Key="Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{DynamicResource Layout.CardPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Badge.Base" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Padding" Value="{DynamicResource Layout.BadgePadding}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Badge.Idle" TargetType="{x:Type Border}" BasedOn="{StaticResource Badge.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Badge.Idle.Background}" />
    </Style>
    <Style x:Key="Badge.Active" TargetType="{x:Type Border}" BasedOn="{StaticResource Badge.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Badge.Active.Background}" />
    </Style>
    <Style x:Key="Badge.Done" TargetType="{x:Type Border}" BasedOn="{StaticResource Badge.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Badge.Done.Background}" />
    </Style>
    <Style x:Key="Badge.Stopped" TargetType="{x:Type Border}" BasedOn="{StaticResource Badge.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Badge.Stopped.Background}" />
    </Style>
    <Style x:Key="Badge.Failed" TargetType="{x:Type Border}" BasedOn="{StaticResource Badge.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Badge.Failed.Background}" />
    </Style>

    <Style x:Key="BadgeText.Base" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BadgeText.Idle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BadgeText.Base}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Badge.Idle.Foreground}" />
    </Style>
    <Style x:Key="BadgeText.Active" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BadgeText.Base}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Badge.Active.Foreground}" />
    </Style>
    <Style x:Key="BadgeText.Done" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BadgeText.Base}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Badge.Done.Foreground}" />
    </Style>
    <Style x:Key="BadgeText.Stopped" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BadgeText.Base}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Badge.Stopped.Foreground}" />
    </Style>
    <Style x:Key="BadgeText.Failed" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BadgeText.Base}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Badge.Failed.Foreground}" />
    </Style>

    <!-- ============================================================
         ToggleButton
         ============================================================ -->
    <ControlTemplate x:Key="ToggleButton.Template" TargetType="{x:Type ToggleButton}">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Radius.Small}"
                SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Control.Hover}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent.Subtle}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Accent.SubtleHover}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Control.Disabled}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ToggleButton.Base" TargetType="{x:Type ToggleButton}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight}" />
        <Setter Property="MinWidth" Value="{DynamicResource Layout.ButtonMinWidth}" />
        <Setter Property="Padding" Value="{DynamicResource Layout.ButtonPadding}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource ToggleButton.Template}" />
    </Style>

    <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource ToggleButton.Base}" />

    <!-- 开关样式：轨道 + 圆点 -->
    <Style x:Key="ToggleSwitch" TargetType="{x:Type ToggleButton}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Track"
                                Width="40" Height="20"
                                CornerRadius="10"
                                Background="{StaticResource Brush.SurfaceAlt}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="Knob"
                                     Width="14" Height="14"
                                     Margin="2,0,0,0"
                                     HorizontalAlignment="Left"
                                     Fill="{StaticResource Brush.Text.Secondary}" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Brush.OnAccent}" />
                            <Setter TargetName="Knob" Property="Margin" Value="22,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Control.Disabled}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Brush.Text.Disabled}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Slider
         ============================================================ -->
    <Style x:Key="Slider.RepeatButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Slider.DecreaseButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{StaticResource Brush.Accent}" Height="4" CornerRadius="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Slider.Thumb" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Ellipse x:Name="Dot"
                             Width="16" Height="16"
                             Fill="{StaticResource Brush.Surface}"
                             Stroke="{StaticResource Brush.Accent}"
                             StrokeThickness="2"
                             SnapsToDevicePixels="True" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Accent.Subtle}" />
                            <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Brush.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Brush.Control.Disabled}" />
                            <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Slider.Base" TargetType="{x:Type Slider}">
        <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight}" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <Border Height="4"
                                Background="{StaticResource Brush.SurfaceAlt}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="2" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                              Style="{StaticResource Slider.DecreaseButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Slider.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                              Style="{StaticResource Slider.RepeatButton}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource Slider.Base}" />

    <!-- ============================================================
         RichTextBox
         ============================================================ -->
    <Style x:Key="RichTextBox.Base" TargetType="{x:Type RichTextBox}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource Layout.InputPadding.Multiline}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RichTextBox}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Input}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Focusable="False"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Focus}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Control.Disabled}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type RichTextBox}" BasedOn="{StaticResource RichTextBox.Base}" />

<!-- ============================================================
         DatePicker（自绘模板：日期文本 + 主题日历按钮）
         不沿用系统模板的原因：
           1. 系统模板把日历按钮浮在文本框上，日期文字会被按钮压住（显示不全）；
           2. 系统日历图标是蓝色位图外观，与主题图标体系冲突。
         弹层仍是 DatePickerCalendar（日历面板），外观通过 Calendar 隐式样式统一底色与文字色。
         ============================================================ -->

    <!-- 日期输入区：与主题输入框同源，但去掉边框，右侧给日历按钮留 26px -->
    <Style x:Key="DatePickerTextBox.Base" TargetType="{x:Type DatePickerTextBox}"
           BasedOn="{StaticResource TextBox.Base}">
        <!-- 高度必须给足（= ControlHeight）：Auto 高度会把字形的上沿裁掉 -->
        <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource Layout.ControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource Layout.DatePickerPadding}" />
        <!-- 必须 Stretch：DatePickerTextBox 默认按内容宽度收缩，
             文本视口会窄到把最后一个字裁掉（"2026/11/5" 显示成 "2026/11:"）。 -->
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <ControlTemplate x:Key="DatePicker.Template" TargetType="{x:Type DatePicker}">
        <Grid>
            <Border x:Name="PART_Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.Input}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 日期文本：右侧留出日历按钮的位置，文字不会被压住 -->
                    <DatePickerTextBox x:Name="PART_TextBox"
                                      Grid.Column="0"
                                      Style="{StaticResource DatePickerTextBox.Base}"
                                      Margin="6,0,0,0"
                                      VerticalContentAlignment="Center" />

                    <!-- 日历按钮：主题图标 + 主题悬停底 -->
                    <ToggleButton x:Name="PART_Toggle"
                                  Grid.Column="1"
                                  Width="26" Height="26"
                                  MinWidth="0" MinHeight="0"
                                  Margin="2,3,3,3"
                                  Focusable="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="{TemplateBinding Foreground}"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="2">
                                    <Path Data="{StaticResource Icon.Geo.Calendar}"
                                          Style="{StaticResource Icon.Regular}"
                                          Fill="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{StaticResource Brush.Control.Hover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>
            </Border>

            <!-- 日历弹层：官方要求弹层里放 DatePickerCalendar，
                 否则 DatePicker 找不到日历、点开是空白。 -->
            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Placement="Bottom"
                   VerticalOffset="2"
                   StaysOpen="False">
                <!-- 日历面板。
                     属性必须直接写在元素上：弹层里的 Calendar 拿不到隐式样式
                     （MinWidth 等会取回 0），面板会塌成一条竖线，
                     星期标题被挤成一排细线。 -->
                <Calendar x:Name="PART_Calendar"
                          MinWidth="240"
                          Background="{StaticResource Brush.Surface}"
                          Foreground="{StaticResource Brush.Text.Primary}"
                          BorderBrush="{StaticResource Brush.Border}"
                          FontFamily="{StaticResource Font.Ui}"
                          FontSize="{StaticResource FontSize.Body}" />
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                <Setter TargetName="PART_Root" Property="Background"
                        Value="{StaticResource Brush.Control.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="DatePicker.Base" TargetType="{x:Type DatePicker}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource DatePicker.Template}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource Brush.Control.Disabled}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type DatePicker}" BasedOn="{StaticResource DatePicker.Base}" />

    <!-- 日历面板（DatePicker 的弹层用的是 DatePicker 自己创建的 Calendar 实例，
         模板里写样式不生效，必须用隐式样式）。
         MinWidth 必须给：DatePicker 会按文本框宽度设置日历宽度，
         布局早期取到 0 时整个面板会塌成竖条，星期标题被挤成细线。 -->
    <Style TargetType="{x:Type Calendar}">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="MinWidth" Value="240" />
    </Style>


    <!-- ============================================================
         ToolBar
         ============================================================ -->
    <Style x:Key="ToolBar.Base" TargetType="{x:Type ToolBar}">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource Layout.ToolBarPadding}" />
        <Setter Property="Height" Value="{DynamicResource Layout.ToolBarHeight}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="{x:Type ToolBar}" BasedOn="{StaticResource ToolBar.Base}" />
    <Style TargetType="{x:Type ToolBarTray}">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ToolBar 里的按钮默认会被系统主题改成扁平凸起块，这里强制回到标准按钮外观。 -->
    <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="{x:Type Button}"
           BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight.Small}" />
    </Style>
    <Style x:Key="{x:Static ToolBar.ToggleButtonStyleKey}" TargetType="{x:Type ToggleButton}"
           BasedOn="{StaticResource ToggleButton.Base}">
        <Setter Property="Height" Value="{DynamicResource Layout.ControlHeight.Small}" />
    </Style>
    <Style x:Key="{x:Static ToolBar.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{StaticResource Brush.Border}" />
        <Setter Property="Margin" Value="4,2" />
    </Style>

    <!-- ============================================================
         Menu / MenuItem（完整模板，避免系统色）
         ============================================================ -->
    <Style TargetType="{x:Type Menu}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- MenuItem：一套模板覆盖 TopLevelHeader / SubmenuHeader / SubmenuItem 三种角色。
         下拉弹层用浅色 Surface 底，避免落到系统默认配色。 -->
    <Style x:Key="MenuItem.Base" TargetType="{x:Type MenuItem}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource Layout.MenuItemPadding}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path x:Name="Check"
                                  Grid.Column="0"
                                  Data="{StaticResource Icon.Geo.Check}"
                                  Style="{StaticResource Icon.Small}"
                                  Margin="4,0,6,0"
                                  Visibility="Collapsed" />

                            <ContentPresenter x:Name="HeaderHost"
                                              Grid.Column="1"
                                              Margin="{TemplateBinding Padding}"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />

                            <TextBlock x:Name="Gesture"
                                       Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Margin="16,0,12,0"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource Brush.Surface}"
                                        BorderBrush="{StaticResource Brush.Border.Strong}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Card}"
                                        Padding="4"
                                        SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Control.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- 顶层菜单向下弹出；子菜单向右弹出 -->
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Right" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter TargetName="PART_Popup" Property="IsOpen" Value="False" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuItem">
                            <Setter TargetName="PART_Popup" Property="IsOpen" Value="False" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MenuItem.Base}" />

</ResourceDictionary>
