    <!-- ============================================================
         4. 图标基础样式 (Path 级封装，自动继承前景)
         ============================================================ -->

    <Style x:Key="Icon.Base" TargetType="{x:Type Path}">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- 默认继承宿主 TextElement.Foreground，在任何深色/浅色/按钮状态下均不失真 -->
        <Setter Property="Fill"
                Value="{Binding Path=(TextElement.Foreground),
                                RelativeSource={RelativeSource AncestorType={x:Type FrameworkElement}},
                                FallbackValue={StaticResource Brush.Text.Primary}}" />
    </Style>

    <!-- 尺寸阶梯样式 -->
    <Style x:Key="Icon.Micro" TargetType="{x:Type Path}" BasedOn="{StaticResource Icon.Base}">
        <Setter Property="Width" Value="{StaticResource Icon.Size.Micro}" />
        <Setter Property="Height" Value="{StaticResource Icon.Size.Micro}" />
    </Style>

    <Style x:Key="Icon.Small" TargetType="{x:Type Path}" BasedOn="{StaticResource Icon.Base}">
        <Setter Property="Width" Value="{StaticResource Icon.Size.Small}" />
        <Setter Property="Height" Value="{StaticResource Icon.Size.Small}" />
    </Style>

    <Style x:Key="Icon.Regular" TargetType="{x:Type Path}" BasedOn="{StaticResource Icon.Base}">
        <Setter Property="Width" Value="{StaticResource Icon.Size.Regular}" />
        <Setter Property="Height" Value="{StaticResource Icon.Size.Regular}" />
    </Style>

    <Style x:Key="Icon.Medium" TargetType="{x:Type Path}" BasedOn="{StaticResource Icon.Base}">
        <Setter Property="Width" Value="{StaticResource Icon.Size.Medium}" />
        <Setter Property="Height" Value="{StaticResource Icon.Size.Medium}" />
    </Style>

    <Style x:Key="Icon.Large" TargetType="{x:Type Path}" BasedOn="{StaticResource Icon.Base}">
        <Setter Property="Width" Value="{StaticResource Icon.Size.Large}" />
        <Setter Property="Height" Value="{StaticResource Icon.Size.Large}" />
    </Style>

    <Style x:Key="Icon.Hero" TargetType="{x:Type Path}" BasedOn="{StaticResource Icon.Base}">
        <Setter Property="Width" Value="{StaticResource Icon.Size.Hero}" />
        <Setter Property="Height" Value="{StaticResource Icon.Size.Hero}" />
    </Style>

    <!-- 语义固定着色图标样式 -->
    <Style x:Key="Icon.Medium.Success" TargetType="{x:Type Path}" BasedOn="{StaticResource Icon.Medium}">
        <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
    </Style>

    <Style x:Key="Icon.Medium.Warning" TargetType="{x:Type Path}" BasedOn="{StaticResource Icon.Medium}">
        <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
    </Style>

    <Style x:Key="Icon.Medium.Danger" TargetType="{x:Type Path}" BasedOn="{StaticResource Icon.Medium}">
        <Setter Property="Fill" Value="{StaticResource Brush.Danger}" />
    </Style>

    <Style x:Key="Icon.Medium.Info" TargetType="{x:Type Path}" BasedOn="{StaticResource Icon.Medium}">
        <Setter Property="Fill" Value="{StaticResource Brush.Accent}" />
    </Style>

    <Style x:Key="Icon.Large.Success" TargetType="{x:Type Path}" BasedOn="{StaticResource Icon.Large}">
        <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
    </Style>

    <Style x:Key="Icon.Large.Warning" TargetType="{x:Type Path}" BasedOn="{StaticResource Icon.Large}">
        <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
    </Style>

    <Style x:Key="Icon.Large.Danger" TargetType="{x:Type Path}" BasedOn="{StaticResource Icon.Large}">
        <Setter Property="Fill" Value="{StaticResource Brush.Danger}" />
    </Style>

    <Style x:Key="Icon.Large.Info" TargetType="{x:Type Path}" BasedOn="{StaticResource Icon.Large}">
        <Setter Property="Fill" Value="{StaticResource Brush.Accent}" />
    </Style>


    <!-- ============================================================
         5. 图标按钮 (IconButton: 正方形、幽灵底、完整悬停与禁用契约)
         ============================================================ -->

    <ControlTemplate x:Key="IconButton.Template" TargetType="{x:Type Button}">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding Tag}"
                SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Control.Hover}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Control.Pressed}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 标准 28x28 图标按钮 (默认) -->
    <Style x:Key="Button.Icon" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="{StaticResource Layout.IconButton.Small}" />
        <Setter Property="Height" Value="{StaticResource Layout.IconButton.Small}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="Tag" Value="{StaticResource Radius.Card}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource IconButton.Template}" />
    </Style>

    <!-- 紧凑 24x24 图标按钮 (表格行、输入框尾部) -->
    <Style x:Key="Button.Icon.Small" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Width" Value="{StaticResource Layout.IconButton.Micro}" />
        <Setter Property="Height" Value="{StaticResource Layout.IconButton.Micro}" />
        <Setter Property="Tag" Value="{StaticResource Radius.Small}" />
    </Style>

    <!-- 大号 34x34 图标按钮 (主工具条) -->
    <Style x:Key="Button.Icon.Large" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Width" Value="{StaticResource Layout.IconButton.Large}" />
        <Setter Property="Height" Value="{StaticResource Layout.IconButton.Large}" />
        <Setter Property="Tag" Value="{StaticResource Radius.Card}" />
    </Style>

    <!-- 危险图标按钮 (删除操作，悬停浅红底红标) -->
    <ControlTemplate x:Key="IconButton.Danger.Template" TargetType="{x:Type Button}">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding Tag}"
                SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Danger.Subtle}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Danger.Subtle}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Danger.Pressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Button.Icon.Danger" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Template" Value="{StaticResource IconButton.Danger.Template}" />
    </Style>

    <Style x:Key="Button.Icon.Danger.Small" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Icon.Small}">
        <Setter Property="Template" Value="{StaticResource IconButton.Danger.Template}" />
    </Style>

</ResourceDictionary>
