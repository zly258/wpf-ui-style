<!--
    WPF UI Skills 示例：分步向导对话框（Wizard / Step Dialog）

    直接可复制到任何业务工程使用的规范模板。
    包含：
    1. 顶部步骤条（Step Indicator）与序号徽章；
    2. 中间步骤内容容器（单层自适应，无多 TabControl 造成的高度跳变）；
    3. 底部上一步、下一步/开始批处理、取消的流程操作栏；
    4. 独立排布的状态与提示文案（防挤压与防遮挡）。
-->
<Window x:Class="YourApp.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图纸批量处理与导出向导"
        Width="920" Height="640"
        MinWidth="680" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Border Background="{StaticResource Brush.WindowBackground}">
        <Grid Margin="{StaticResource Layout.WindowPadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. 顶部步骤条指示器 -->
            <Border Grid.Row="0"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}"
                    Padding="16,12"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 步骤 1 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource Brush.Accent}" Margin="0,0,8,0">
                            <TextBlock Text="1" Foreground="{StaticResource Brush.OnAccent}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="第 1 步" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="选择源图纸" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Width="40" Height="2" Background="{StaticResource Brush.Border}" VerticalAlignment="Center" Margin="8,0" />

                    <!-- 步骤 2 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource Brush.SurfaceAlt}" Margin="0,0,8,0">
                            <TextBlock Text="2" Foreground="{StaticResource Brush.Text.Secondary}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="第 2 步" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="配置转换规则" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text.Secondary}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="3" Width="40" Height="2" Background="{StaticResource Brush.Border}" VerticalAlignment="Center" Margin="8,0" />

                    <!-- 步骤 3 -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource Brush.SurfaceAlt}" Margin="0,0,8,0">
                            <TextBlock Text="3" Foreground="{StaticResource Brush.Text.Secondary}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="第 3 步" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="确认与批处理" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text.Secondary}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. 中间步骤内容容器 -->
            <Border Grid.Row="1"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}"
                    Padding="20,16">
                <Grid>
                    <!-- 第 1 步页面示例 -->
                    <Grid Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="选择待批处理的工程图纸与模型文件" Style="{StaticResource Text.Section}" FontWeight="SemiBold" />
                            <TextBlock Text="支持 Autodesk Inventor (.idw/.dwg/.iam/.ipt) 文件批量导入解析。" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="{StaticResource Layout.FormLabelMinWidth}" />
                                <ColumnDefinition Width="*" MinWidth="{StaticResource Layout.InputMinWidth}" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="源工程目录" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="D:\Projects\Mechanical-Assembly\Drawings" Margin="0,3,8,3" VerticalAlignment="Center" />
                            <Button Grid.Row="0" Grid.Column="2" Content="浏览..." Style="{StaticResource Button.Secondary}" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="包含子目录" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                <CheckBox Content="递归遍历所有子文件夹" IsChecked="True" Margin="0,0,16,0" />
                                <CheckBox Content="自动跳过只读库文件" IsChecked="True" />
                            </StackPanel>

                            <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Header="已检索到的待处理文件清单 (6 份)">
                                <ListBox>
                                    <ListBoxItem Content="ASM-0482_减速箱总成.dwg (总装图 · 12.4 MB)" IsSelected="True" />
                                    <ListBoxItem Content="PRT-1001_箱体底座.dwg (铸造件 · 6.8 MB)" />
                                    <ListBoxItem Content="PRT-1002_输入高速轴.dwg (轴类件 · 3.2 MB)" />
                                    <ListBoxItem Content="PRT-1003_斜齿小齿轮.dwg (齿轮类 · 2.9 MB)" />
                                </ListBox>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. 底部步进控制栏 -->
            <Border Grid.Row="2"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="0,12,0,0"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="请确认选择需要处理的文件后，点击“下一步”进行规则设定。"
                               Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="上一步" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" IsEnabled="False" />
                        <Button Content="下一步" Style="{StaticResource Button.Primary}" Margin="0,0,8,0" />
                        <Button Content="取消" Style="{StaticResource Button.Secondary}" />
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
