<!--
    示例窗口：双栏对照与日志流布局骨架。
    演示点：
      1. 左右对照面板 + 底部日志区，主内容占 * 行，日志固定高度；
      2. 对照区与日志区各自滚动，不互相争抢高度；
      3. 面板头是工具栏行：标题居左、快速操作居右；
      4. 底部操作栏固定在窗口底部，即使日志内容很长也不会顶出屏幕。
-->
<Window x:Class="YourApp.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工程图纸模型版本差异比对与审计"
        Width="1180"
        Height="720"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="{StaticResource Layout.WindowPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头：标题与快捷操作 -->
        <Border Grid.Row="0"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="总装配图纸.dwg · 设计版本对比 (Rev A vs Rev B)" Style="{StaticResource Text.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="上一处差异" Style="{StaticResource Button.Secondary.Small}" ToolTip="定位到上一个差异项 (F3)" Margin="0,0,4,0" />
                    <Button Content="下一处差异" Style="{StaticResource Button.Secondary.Small}" ToolTip="定位到下一个差异项 (F4)" Margin="0,0,4,0" />
                    <Button Content="导出比对报告" Style="{StaticResource Button.Secondary.Small}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 对照区：左右两栏平分，各自滚动 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource Layout.ColumnGap}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：基础基线版本 -->
            <Border Grid.Column="0"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}"
                    Background="{StaticResource Brush.Surface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource Brush.SurfaceSunken}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,0,0,1"
                            Padding="10,6">
                        <Grid>
                            <TextBlock Text="基线版本 (Rev A · 2026-10-15)" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                            <TextBlock Text="共 142 个特征节点" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewer.Base}">
                        <TextBox Text="[BOM-101] 主减速箱箱体毛坯 · 灰铸铁 HT250&#x0a;[DIM-001] 主安装中心距: 420.00 mm (±0.05)&#x0a;[PRT-002] 轴承端盖紧固螺栓 M12x45 (8.8级)&#x0a;[TOL-003] 轴承孔同轴度: 0.02 A-B&#x0a;[MAT-004] 润滑油标号: L-CKD 220 重负荷齿轮油"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="10" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右：最新变更版本 -->
            <Border Grid.Column="2"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}"
                    Background="{StaticResource Brush.Surface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource Brush.SurfaceSunken}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,0,0,1"
                            Padding="10,6">
                        <Grid>
                            <TextBlock Text="变更版本 (Rev B · 当前设计)" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" />
                            <TextBlock Text="检测到 2 处设计差异" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewer.Base}">
                        <TextBox Text="[BOM-101] 主减速箱箱体毛坯 · 球墨铸铁 QT500-7 [已变更材料]&#x0a;[DIM-001] 主安装中心距: 420.00 mm (±0.03) [精度加严]&#x0a;[PRT-002] 轴承端盖紧固螺栓 M12x45 (8.8级)&#x0a;[TOL-003] 轴承孔同轴度: 0.02 A-B&#x0a;[MAT-004] 润滑油标号: L-CKD 220 重负荷齿轮油"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="10" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部日志区：固定高度 120 DIP，独立滚动 -->
        <GroupBox Grid.Row="2" Header="变更审核与检查器日志" Margin="0,10,0,0">
            <ScrollViewer Height="110" Style="{StaticResource ScrollViewer.Base}">
                <TextBox Text="18:30:02 [INFO] 开始解析几何实体与属性字典...&#x0a;18:30:03 [DIFF] BOM-101 材料变更: HT250 -> QT500-7&#x0a;18:30:03 [DIFF] DIM-001 公差由 ±0.05 调整为 ±0.03&#x0a;18:30:04 [CHECK] 校验通过：未发现结构性装配干涉"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="6" />
            </ScrollViewer>
        </GroupBox>

        <!-- 底部操作按钮栏 -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="差异比对已就绪，可直接合并变更或签发技术修改通知单 (ECN)"
                       Style="{StaticResource Text.Caption}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="拒绝变更" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                <Button Content="批准并同步版本" Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
