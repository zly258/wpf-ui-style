<!--
    示例窗口：密集设置表单骨架（三列并排、高密度防截断）。
    演示点：
      1. 使用 SizeToContent="Height" + MinHeight，内容区一层 ScrollViewer；
      2. 表单采用三列布局骨架（标签 Auto+MinWidth / 输入 *+MinWidth），行距由 Layout.FormRowMargin 统一控制；
      3. 一屏展示更多字段，整洁不空旷；
      4. 底部操作栏独占一行，状态文案位于操作栏上方，避免挤压按钮。
-->
<Window x:Class="YourApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工程参数与全局选项设置"
        Width="1040"
        Height="720"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="{StaticResource Layout.WindowPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头：标题 + 一句话说明 -->
        <Border Grid.Row="0"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="工程参数与全局选项设置" Style="{StaticResource Text.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="紧凑骨架：三列并排，行距 3px，中等密度控件高 30px"
                           Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 内容区：唯一的垂直滚动层 -->
        <ScrollViewer Grid.Row="1"
                      Style="{StaticResource ScrollViewer.Base}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- 分组 1：服务与接口连接 -->
                <GroupBox Header="服务与集群连接配置">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="{StaticResource Layout.FormLabelMinWidth}" />
                            <ColumnDefinition Width="*" MinWidth="{StaticResource Layout.InputMinWidth}" />
                            <ColumnDefinition Width="{StaticResource Layout.ColumnGap}" />
                            <ColumnDefinition Width="Auto" MinWidth="{StaticResource Layout.FormLabelMinWidth}" />
                            <ColumnDefinition Width="*" MinWidth="{StaticResource Layout.InputMinWidth}" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="主节点地址" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="{StaticResource Layout.FormRowMargin}" Text="https://cluster.internal:9443" />

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="通信秘钥 (Token)" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <PasswordBox Grid.Row="0" Grid.Column="4" Margin="{StaticResource Layout.FormRowMargin}" Password="••••••••••••" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="请求超时 (秒)" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="{StaticResource Layout.FormRowMargin}" Text="60" />

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="并发工作线程" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="4" Margin="{StaticResource Layout.FormRowMargin}" SelectedIndex="2">
                            <ComboBoxItem Content="2 核心线程" />
                            <ComboBoxItem Content="4 核心线程" />
                            <ComboBoxItem Content="8 核心线程 (推荐)" />
                            <ComboBoxItem Content="16 核心线程" />
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <!-- 分组 2：图纸与输出规范 -->
                <GroupBox Header="图纸转换与几何抽取规则" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="{StaticResource Layout.FormLabelMinWidth}" />
                            <ColumnDefinition Width="*" MinWidth="{StaticResource Layout.InputMinWidth}" />
                            <ColumnDefinition Width="{StaticResource Layout.ColumnGap}" />
                            <ColumnDefinition Width="Auto" MinWidth="{StaticResource Layout.FormLabelMinWidth}" />
                            <ColumnDefinition Width="*" MinWidth="{StaticResource Layout.InputMinWidth}" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="目标版本格式" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="{StaticResource Layout.FormRowMargin}" SelectedIndex="0">
                            <ComboBoxItem Content="标准工业交换格式 (STEP AP242)" />
                            <ComboBoxItem Content="通用几何面模型 (IGES 5.3)" />
                            <ComboBoxItem Content="轻量化工程图 (PDF/A-1b)" />
                        </ComboBox>

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="几何线宽映射" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="4" Margin="{StaticResource Layout.FormRowMargin}" SelectedIndex="1">
                            <ComboBoxItem Content="保持图元原始线宽" />
                            <ComboBoxItem Content="映射至国标 GB 粗细线对 (0.35/0.70)" />
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="文字编码策略" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="{StaticResource Layout.FormRowMargin}" SelectedIndex="0">
                            <ComboBoxItem Content="UTF-8 (推荐通用)" />
                            <ComboBoxItem Content="GB18030 兼容模式" />
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="自动备份目录" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="4" Margin="{StaticResource Layout.FormRowMargin}" Text="D:\ProjectBackups\AutoRecover" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="处理流水线行为" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,6,0,0">
                            <CheckBox Content="自动修复断开的多段线" IsChecked="True" Margin="0,0,16,0" />
                            <CheckBox Content="忽略空图层与不可见块定义" IsChecked="True" Margin="0,0,16,0" />
                            <CheckBox Content="遇到非致命语法错误时继续批处理" IsChecked="True" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- 状态提示行：独立占一行，长文案不顶按钮 -->
        <TextBlock Grid.Row="2"
                   Text="修改已在本地草稿中缓存。点击“保存并应用”后将同步至配置文件与工作区。"
                   Style="{StaticResource Text.Caption}"
                   Foreground="{StaticResource Brush.Text.Secondary}"
                   Margin="0,10,0,10" />

        <!-- 底部按钮栏：靠右排布 -->
        <Border Grid.Row="3"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="0,10,0,0">
            <Grid>
                <Button Content="重置为默认值" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" />
                    <Button Content="保存并应用" Style="{StaticResource Button.Primary}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
