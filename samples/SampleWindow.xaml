<!--
    示例窗口：演示本规范的布局、状态和令牌用法。
    使用前：
      1. 在 App.xaml 或 ThemeLoader 中合并 Theme/Theme.xaml。
      2. 把 x:Class 改成你的命名空间和类名。
      3. 不要在这里写任何 #RRGGBB 颜色。
-->
<Window x:Class="YourApp.SampleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenCADTranslate 示例"
        Width="760" Height="680"
        MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="{StaticResource Layout.WindowPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="图纸翻译" Style="{StaticResource Text.Title}" />
            <TextBlock Text="选择目标目录和翻译范围，然后开始处理。"
                       Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 内容：只保留一层垂直滚动 -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- 表单 -->
                <GroupBox Header="翻译服务">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="服务地址" Style="{StaticResource Text.Label}" />
                        <TextBox Grid.Column="1" Margin="0,4"
                                 Text="http://127.0.0.1:21894/v1" />

                        <TextBlock Grid.Column="3" Text="模型名称"
                                   Style="{StaticResource Text.Label}" />
                        <TextBox Grid.Column="4" Margin="0,4"
                                 Text="hy-mt2:1.8b-8k" />

                        <TextBlock Grid.Row="1" Text="访问令牌"
                                   Style="{StaticResource Text.Label}" />
                        <PasswordBox Grid.Row="1" Grid.Column="1" Margin="0,4" />

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="超时（秒）"
                                   Style="{StaticResource Text.Label}" />
                        <TextBox Grid.Row="1" Grid.Column="4" Margin="0,4" Text="300" />

                        <TextBlock Grid.Row="2" Text="目标语言"
                                   Style="{StaticResource Text.Label}" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="英语（en）" />
                            <ComboBoxItem Content="中文（zh）" />
                            <ComboBoxItem Content="俄语（ru）" />
                        </ComboBox>

                        <StackPanel Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2"
                                    Orientation="Horizontal" Margin="0,4">
                            <CheckBox Content="跳过已是目标语言的文本" />
                            <CheckBox Content="启用术语库" IsChecked="True" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- 选项 -->
                <GroupBox Header="翻译范围">
                    <WrapPanel>
                        <CheckBox Content="单行文本" IsChecked="True" Width="140" />
                        <CheckBox Content="多行文本" IsChecked="True" Width="140" />
                        <CheckBox Content="引线文本" IsChecked="True" Width="140" />
                        <CheckBox Content="块属性" IsChecked="True" Width="140" />
                        <CheckBox Content="表格单元格" IsChecked="True" Width="140" />
                        <CheckBox Content="尺寸文字" Width="140" />
                    </WrapPanel>
                </GroupBox>

                <!-- 高级设置：默认折叠 -->
                <Expander Header="高级设置" IsExpanded="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Text="以下参数一般保持默认即可。" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="并发请求数"
                                       Style="{StaticResource Text.Label}" />
                            <TextBox Grid.Column="1" Margin="0,4" Text="4" />

                            <TextBlock Grid.Column="3" Text="重试次数"
                                       Style="{StaticResource Text.Label}" />
                            <TextBox Grid.Column="4" Margin="0,4" Text="1" />

                            <TextBlock Grid.Row="1" Text="系统提示词"
                                       Style="{StaticResource Text.Label}"
                                       VerticalAlignment="Top" />
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"
                                     Style="{StaticResource TextBox.Multiline}"
                                     MaxHeight="120"
                                     Margin="0,4" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- 列表 -->
                <GroupBox Header="待处理图纸">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="添加文件…" Margin="0,0,8,0" />
                            <Button Content="添加目录…" Margin="0,0,8,0" />
                            <Button Content="移除选中" Style="{StaticResource Button.Text}" />
                        </StackPanel>

                        <ListBox Grid.Row="1" Height="120">
                            <ListBoxItem Content="A-001 总装图.dwg" />
                            <ListBoxItem Content="A-002 零件图.dwg" IsSelected="True" />
                            <ListBoxItem Content="A-003 明细表.dwg" />
                        </ListBox>
                    </Grid>
                </GroupBox>

                <!-- 日志 -->
                <GroupBox Header="处理日志">
                    <TextBox Style="{StaticResource TextBox.Code}"
                             Text="[10:00:01] 开始处理 A-001 总装图.dwg&#x0a;[10:00:03] 已翻译 42 条文本"
                             MaxHeight="{StaticResource Layout.LogMaxHeight}" />
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作栏 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource Text.Caption}"
                       Text="就绪" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="开始翻译" Style="{StaticResource Button.Primary}"
                        IsDefault="True" MinWidth="96"
                        ToolTip="开始处理列表中的图纸" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
